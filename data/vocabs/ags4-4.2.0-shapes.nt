<https://w3id.org/ags4/shapes/DCPG-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DCPG-key-null> <http://www.w3.org/ns/shacl#message> "Another DCPG record has the same combination of KEY fields (LOCA_ID, DCPG_DATE, DCPG_TESN, DCPG_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DCPG-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DCPG-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DCPG_DATE ?n1 } || NOT EXISTS { $this ags:DCPG_TESN ?n2 } || NOT EXISTS { $this ags:DCPG_DPTH ?n3 }) }\n    ?xother a ags:DCPG .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:DCPG_DATE ?a1 } OPTIONAL { ?xother ags:DCPG_DATE ?b1 }\n    OPTIONAL { $this ags:DCPG_TESN ?a2 } OPTIONAL { ?xother ags:DCPG_TESN ?b2 }\n    OPTIONAL { $this ags:DCPG_DPTH ?a3 } OPTIONAL { ?xother ags:DCPG_DPTH ?b3 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\"))\n}" .
<https://w3id.org/ags4/shapes/DCPG-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DCPG-key> <http://www.w3.org/ns/shacl#message> "Another DCPG record has the same combination of KEY fields (LOCA_ID, DCPG_DATE, DCPG_TESN, DCPG_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DCPG-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DCPG-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:DCPG_DATE ?v1 .\n    $this ags:DCPG_TESN ?v2 .\n    $this ags:DCPG_DPTH ?v3 .\n    ?xother ags:DCPG_DATE ?v1 .\n    ?xother ags:DCPG_TESN ?v2 .\n    ?xother ags:DCPG_DPTH ?v3 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:DCPG }\n}" .
<https://w3id.org/ags4/shapes/DCPG-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DCPG-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/DCPG-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DCPG-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/DCPG-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
