<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <http://www.w3.org/ns/shacl#name> "LOCA_ID" .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#Literal> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <http://www.w3.org/ns/shacl#order> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/LOCA_ID> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/ID> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/LOCA_ID> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <https://w3id.org/ags4/ont/headingStatus> "*" .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <https://w3id.org/ags4/ont/isKey> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/DMTZ-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/DMTZ-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DMTZ-key-null> <http://www.w3.org/ns/shacl#message> "Another DMTZ record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMTZ_DATE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DMTZ-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DMTZ-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DMTG_TESN ?n1 } || NOT EXISTS { $this ags:DMTZ_DATE ?n2 }) }\n    ?xother a ags:DMTZ .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:DMTG_TESN ?a1 } OPTIONAL { ?xother ags:DMTG_TESN ?b1 }\n    OPTIONAL { $this ags:DMTZ_DATE ?a2 } OPTIONAL { ?xother ags:DMTZ_DATE ?b2 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\"))\n}" .
<https://w3id.org/ags4/shapes/DMTZ-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DMTZ-key> <http://www.w3.org/ns/shacl#message> "Another DMTZ record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMTZ_DATE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DMTZ-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DMTZ-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:DMTG_TESN ?v1 .\n    $this ags:DMTZ_DATE ?v2 .\n    ?xother ags:DMTZ_DATE ?v2 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:DMTG_TESN ?v1 }\n    FILTER EXISTS { ?xother a ags:DMTZ }\n}" .
<https://w3id.org/ags4/shapes/DMTZ-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DMTZ-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching DMTG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/DMTZ-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DMTZ-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:DMTG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
