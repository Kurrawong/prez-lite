<https://w3id.org/ags4/shapes/ISTA-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ISTA-key-null> <http://www.w3.org/ns/shacl#message> "Another ISTA record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTA_TOP, ISTA_BASE, ISTA_ANYN): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ISTA-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ISTA-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:ISTG_TESN ?n1 } || NOT EXISTS { $this ags:ISTA_TOP ?n2 } || NOT EXISTS { $this ags:ISTA_BASE ?n3 } || NOT EXISTS { $this ags:ISTA_ANYN ?n4 }) }\n    ?xother a ags:ISTA .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:ISTG_TESN ?a1 } OPTIONAL { ?xother ags:ISTG_TESN ?b1 }\n    OPTIONAL { $this ags:ISTA_TOP ?a2 } OPTIONAL { ?xother ags:ISTA_TOP ?b2 }\n    OPTIONAL { $this ags:ISTA_BASE ?a3 } OPTIONAL { ?xother ags:ISTA_BASE ?b3 }\n    OPTIONAL { $this ags:ISTA_ANYN ?a4 } OPTIONAL { ?xother ags:ISTA_ANYN ?b4 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\"))\n}" .
<https://w3id.org/ags4/shapes/ISTA-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ISTA-key> <http://www.w3.org/ns/shacl#message> "Another ISTA record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTA_TOP, ISTA_BASE, ISTA_ANYN): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ISTA-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ISTA-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:ISTG_TESN ?v1 .\n    $this ags:ISTA_TOP ?v2 .\n    $this ags:ISTA_BASE ?v3 .\n    $this ags:ISTA_ANYN ?v4 .\n    ?xother ags:ISTA_TOP ?v2 .\n    ?xother ags:ISTA_BASE ?v3 .\n    ?xother ags:ISTA_ANYN ?v4 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:ISTG_TESN ?v1 }\n    FILTER EXISTS { ?xother a ags:ISTA }\n}" .
<https://w3id.org/ags4/shapes/ISTA-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ISTA-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching ISTG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/ISTA-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ISTA-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:ISTG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/ISTA-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/ISTA-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/ISTG> .
<https://w3id.org/ags4/shapes/ISTA-parent> <http://www.w3.org/ns/shacl#description> "The ISTG (In Situ Seismic Test - General) record this ISTA record belongs to (Rule 10c)."@en .
