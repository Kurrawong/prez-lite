<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/LOCA_ID> .
<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/ID> .
<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/LOCA_ID> .
<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <https://w3id.org/ags4/ont/headingStatus> "*" .
<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <https://w3id.org/ags4/ont/isKey> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/GEOL-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/GEOL-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/GEOL-key-null> <http://www.w3.org/ns/shacl#message> "Another GEOL record has the same combination of KEY fields (LOCA_ID, GEOL_TOP, GEOL_BASE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/GEOL-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/GEOL-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:GEOL_TOP ?n1 } || NOT EXISTS { $this ags:GEOL_BASE ?n2 }) }\n    ?xother a ags:GEOL .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:GEOL_TOP ?a1 } OPTIONAL { ?xother ags:GEOL_TOP ?b1 }\n    OPTIONAL { $this ags:GEOL_BASE ?a2 } OPTIONAL { ?xother ags:GEOL_BASE ?b2 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\"))\n}" .
<https://w3id.org/ags4/shapes/GEOL-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/GEOL-key> <http://www.w3.org/ns/shacl#message> "Another GEOL record has the same combination of KEY fields (LOCA_ID, GEOL_TOP, GEOL_BASE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/GEOL-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/GEOL-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:GEOL_TOP ?v1 .\n    $this ags:GEOL_BASE ?v2 .\n    ?xother ags:GEOL_TOP ?v1 .\n    ?xother ags:GEOL_BASE ?v2 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:GEOL }\n}" .
<https://w3id.org/ags4/shapes/GEOL-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/GEOL-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/GEOL-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/GEOL-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/GEOL-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
