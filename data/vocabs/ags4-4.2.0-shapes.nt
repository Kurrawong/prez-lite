<https://w3id.org/ags4/shapes/DICT-key-null> <http://www.w3.org/ns/shacl#message> "Another DICT record has the same combination of KEY fields (DICT_TYPE, DICT_GRP, DICT_HDNG): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DICT-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DICT-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:DICT_TYPE ?n0 } || NOT EXISTS { $this ags:DICT_GRP ?n1 } || NOT EXISTS { $this ags:DICT_HDNG ?n2 }) }\n    ?xother a ags:DICT .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:DICT_TYPE ?a0 } OPTIONAL { ?xother ags:DICT_TYPE ?b0 }\n    OPTIONAL { $this ags:DICT_GRP ?a1 } OPTIONAL { ?xother ags:DICT_GRP ?b1 }\n    OPTIONAL { $this ags:DICT_HDNG ?a2 } OPTIONAL { ?xother ags:DICT_HDNG ?b2 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\"))\n}" .
<https://w3id.org/ags4/shapes/DICT-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DICT-key> <http://www.w3.org/ns/shacl#message> "Another DICT record has the same combination of KEY fields (DICT_TYPE, DICT_GRP, DICT_HDNG): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DICT-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DICT-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:DICT_TYPE ?v0 .\n    $this ags:DICT_GRP ?v1 .\n    $this ags:DICT_HDNG ?v2 .\n    ?xother ags:DICT_TYPE ?v0 .\n    ?xother ags:DICT_GRP ?v1 .\n    ?xother ags:DICT_HDNG ?v2 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother a ags:DICT }\n}" .
