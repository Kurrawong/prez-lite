<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#Literal> .
<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <http://www.w3.org/ns/shacl#order> "13"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/TEST_STAT> .
<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/X> .
<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/TEST_STAT> .
<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <https://w3id.org/ags4/ont/isKey> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/IRDX-TEST_STAT> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/IRDX-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/IRDX-key-null> <http://www.w3.org/ns/shacl#message> "Another IRDX record has the same combination of KEY fields (LOCA_ID, IRDX_DPTH, IRDX_TESN): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/IRDX-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/IRDX-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:IRDX_DPTH ?n1 } || NOT EXISTS { $this ags:IRDX_TESN ?n2 }) }\n    ?xother a ags:IRDX .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:IRDX_DPTH ?a1 } OPTIONAL { ?xother ags:IRDX_DPTH ?b1 }\n    OPTIONAL { $this ags:IRDX_TESN ?a2 } OPTIONAL { ?xother ags:IRDX_TESN ?b2 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\"))\n}" .
<https://w3id.org/ags4/shapes/IRDX-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/IRDX-key> <http://www.w3.org/ns/shacl#message> "Another IRDX record has the same combination of KEY fields (LOCA_ID, IRDX_DPTH, IRDX_TESN): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/IRDX-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/IRDX-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:IRDX_DPTH ?v1 .\n    $this ags:IRDX_TESN ?v2 .\n    ?xother ags:IRDX_DPTH ?v1 .\n    ?xother ags:IRDX_TESN ?v2 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:IRDX }\n}" .
<https://w3id.org/ags4/shapes/IRDX-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/IRDX-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/IRDX-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/IRDX-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/IRDX-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
