<https://w3id.org/ags4/shapes/CPTG-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CPTG-key-null> <http://www.w3.org/ns/shacl#message> "Another CPTG record has the same combination of KEY fields (LOCA_ID, CPTG_TESN): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/CPTG-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CPTG-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:CPTG_TESN ?n1 }) }\n    ?xother a ags:CPTG .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:CPTG_TESN ?a1 } OPTIONAL { ?xother ags:CPTG_TESN ?b1 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\"))\n}" .
<https://w3id.org/ags4/shapes/CPTG-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CPTG-key> <http://www.w3.org/ns/shacl#message> "Another CPTG record has the same combination of KEY fields (LOCA_ID, CPTG_TESN): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/CPTG-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CPTG-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:CPTG_TESN ?v1 .\n    ?xother ags:CPTG_TESN ?v1 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:CPTG }\n}" .
<https://w3id.org/ags4/shapes/CPTG-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CPTG-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/CPTG-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CPTG-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/CPTG-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
