<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/LOCA_ID> .
<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/ID> .
<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/LOCA_ID> .
<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <https://w3id.org/ags4/ont/headingStatus> "*" .
<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <https://w3id.org/ags4/ont/isKey> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/CPDT-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/CPDT-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CPDT-key-null> <http://www.w3.org/ns/shacl#message> "Another CPDT record has the same combination of KEY fields (LOCA_ID, CPTG_TESN, CPDG_DPTH, CPDT_TIME): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/CPDT-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CPDT-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:CPTG_TESN ?n1 } || NOT EXISTS { $this ags:CPDG_DPTH ?n2 } || NOT EXISTS { $this ags:CPDT_TIME ?n3 }) }\n    ?xother a ags:CPDT .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:CPTG_TESN ?a1 } OPTIONAL { ?xother ags:CPTG_TESN ?b1 }\n    OPTIONAL { $this ags:CPDG_DPTH ?a2 } OPTIONAL { ?xother ags:CPDG_DPTH ?b2 }\n    OPTIONAL { $this ags:CPDT_TIME ?a3 } OPTIONAL { ?xother ags:CPDT_TIME ?b3 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\"))\n}" .
<https://w3id.org/ags4/shapes/CPDT-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CPDT-key> <http://www.w3.org/ns/shacl#message> "Another CPDT record has the same combination of KEY fields (LOCA_ID, CPTG_TESN, CPDG_DPTH, CPDT_TIME): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/CPDT-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CPDT-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:CPTG_TESN ?v1 .\n    $this ags:CPDG_DPTH ?v2 .\n    $this ags:CPDT_TIME ?v3 .\n    ?xother ags:CPDT_TIME ?v3 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:CPTG_TESN ?v1 }\n    FILTER EXISTS { ?xother ags:CPDG_DPTH ?v2 }\n    FILTER EXISTS { ?xother a ags:CPDT }\n}" .
<https://w3id.org/ags4/shapes/CPDT-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CPDT-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching CPDG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/CPDT-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CPDT-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:CPTG_TESN, ags:CPDG_DPTH))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/CPDT-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/CPDT-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/CPDG> .
