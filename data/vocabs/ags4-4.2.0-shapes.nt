<https://w3id.org/ags4/shapes/PMMD-PMMG_TESN> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/PMMD-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PMMD-key-null> <http://www.w3.org/ns/shacl#message> "Another PMMD record has the same combination of KEY fields (LOCA_ID, PMMG_DPTH, PMMG_TESN, PMMD_SEQ): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PMMD-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PMMD-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PMMG_DPTH ?n1 } || NOT EXISTS { $this ags:PMMG_TESN ?n2 } || NOT EXISTS { $this ags:PMMD_SEQ ?n3 }) }\n    ?xother a ags:PMMD .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:PMMG_DPTH ?a1 } OPTIONAL { ?xother ags:PMMG_DPTH ?b1 }\n    OPTIONAL { $this ags:PMMG_TESN ?a2 } OPTIONAL { ?xother ags:PMMG_TESN ?b2 }\n    OPTIONAL { $this ags:PMMD_SEQ ?a3 } OPTIONAL { ?xother ags:PMMD_SEQ ?b3 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\"))\n}" .
<https://w3id.org/ags4/shapes/PMMD-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PMMD-key> <http://www.w3.org/ns/shacl#message> "Another PMMD record has the same combination of KEY fields (LOCA_ID, PMMG_DPTH, PMMG_TESN, PMMD_SEQ): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PMMD-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PMMD-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:PMMG_DPTH ?v1 .\n    $this ags:PMMG_TESN ?v2 .\n    $this ags:PMMD_SEQ ?v3 .\n    ?xother ags:PMMD_SEQ ?v3 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:PMMG_DPTH ?v1 }\n    FILTER EXISTS { ?xother ags:PMMG_TESN ?v2 }\n    FILTER EXISTS { ?xother a ags:PMMD }\n}" .
<https://w3id.org/ags4/shapes/PMMD-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PMMD-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching PMMG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/PMMD-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PMMD-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:PMMG_DPTH, ags:PMMG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/PMMD-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
