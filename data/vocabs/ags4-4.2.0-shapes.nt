<https://w3id.org/ags4/shapes/MOND-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/MOND-key-null> <http://www.w3.org/ns/shacl#message> "Another MOND record has the same combination of KEY fields (LOCA_ID, MONG_ID, MONG_DIS, MOND_DTIM, MOND_TYPE, MOND_REF): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/MOND-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/MOND-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:MONG_ID ?n1 } || NOT EXISTS { $this ags:MONG_DIS ?n2 } || NOT EXISTS { $this ags:MOND_DTIM ?n3 } || NOT EXISTS { $this ags:MOND_TYPE ?n4 } || NOT EXISTS { $this ags:MOND_REF ?n5 }) }\n    ?xother a ags:MOND .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:MONG_ID ?a1 } OPTIONAL { ?xother ags:MONG_ID ?b1 }\n    OPTIONAL { $this ags:MONG_DIS ?a2 } OPTIONAL { ?xother ags:MONG_DIS ?b2 }\n    OPTIONAL { $this ags:MOND_DTIM ?a3 } OPTIONAL { ?xother ags:MOND_DTIM ?b3 }\n    OPTIONAL { $this ags:MOND_TYPE ?a4 } OPTIONAL { ?xother ags:MOND_TYPE ?b4 }\n    OPTIONAL { $this ags:MOND_REF ?a5 } OPTIONAL { ?xother ags:MOND_REF ?b5 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\") && COALESCE(STR(?a5), \"\") = COALESCE(STR(?b5), \"\"))\n}" .
<https://w3id.org/ags4/shapes/MOND-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/MOND-key> <http://www.w3.org/ns/shacl#message> "Another MOND record has the same combination of KEY fields (LOCA_ID, MONG_ID, MONG_DIS, MOND_DTIM, MOND_TYPE, MOND_REF): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/MOND-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/MOND-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:MONG_ID ?v1 .\n    $this ags:MONG_DIS ?v2 .\n    $this ags:MOND_DTIM ?v3 .\n    $this ags:MOND_TYPE ?v4 .\n    $this ags:MOND_REF ?v5 .\n    ?xother ags:MOND_DTIM ?v3 .\n    ?xother ags:MOND_TYPE ?v4 .\n    ?xother ags:MOND_REF ?v5 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:MONG_ID ?v1 }\n    FILTER EXISTS { ?xother ags:MONG_DIS ?v2 }\n    FILTER EXISTS { ?xother a ags:MOND }\n}" .
<https://w3id.org/ags4/shapes/MOND-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/MOND-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching MONG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/MOND-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/MOND-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:MONG_ID, ags:MONG_DIS))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/MOND-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
