<https://w3id.org/ags4/shapes/WGPT-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/WGPT-key-null> <http://www.w3.org/ns/shacl#message> "Another WGPT record has the same combination of KEY fields (LOCA_ID, WGPG_ID, WGPG_TOOL, WGPT_PARA, WGPT_UNIT, WGPT_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/WGPT-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/WGPT-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:WGPG_ID ?n1 } || NOT EXISTS { $this ags:WGPG_TOOL ?n2 } || NOT EXISTS { $this ags:WGPT_PARA ?n3 } || NOT EXISTS { $this ags:WGPT_UNIT ?n4 } || NOT EXISTS { $this ags:WGPT_DPTH ?n5 }) }\n    ?xother a ags:WGPT .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:WGPG_ID ?a1 } OPTIONAL { ?xother ags:WGPG_ID ?b1 }\n    OPTIONAL { $this ags:WGPG_TOOL ?a2 } OPTIONAL { ?xother ags:WGPG_TOOL ?b2 }\n    OPTIONAL { $this ags:WGPT_PARA ?a3 } OPTIONAL { ?xother ags:WGPT_PARA ?b3 }\n    OPTIONAL { $this ags:WGPT_UNIT ?a4 } OPTIONAL { ?xother ags:WGPT_UNIT ?b4 }\n    OPTIONAL { $this ags:WGPT_DPTH ?a5 } OPTIONAL { ?xother ags:WGPT_DPTH ?b5 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\") && COALESCE(STR(?a5), \"\") = COALESCE(STR(?b5), \"\"))\n}" .
<https://w3id.org/ags4/shapes/WGPT-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/WGPT-key> <http://www.w3.org/ns/shacl#message> "Another WGPT record has the same combination of KEY fields (LOCA_ID, WGPG_ID, WGPG_TOOL, WGPT_PARA, WGPT_UNIT, WGPT_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/WGPT-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/WGPT-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:WGPG_ID ?v1 .\n    $this ags:WGPG_TOOL ?v2 .\n    $this ags:WGPT_PARA ?v3 .\n    $this ags:WGPT_UNIT ?v4 .\n    $this ags:WGPT_DPTH ?v5 .\n    ?xother ags:WGPT_PARA ?v3 .\n    ?xother ags:WGPT_UNIT ?v4 .\n    ?xother ags:WGPT_DPTH ?v5 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:WGPG_ID ?v1 }\n    FILTER EXISTS { ?xother ags:WGPG_TOOL ?v2 }\n    FILTER EXISTS { ?xother a ags:WGPT }\n}" .
<https://w3id.org/ags4/shapes/WGPT-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/WGPT-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching WGPG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/WGPT-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/WGPT-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:WGPG_ID, ags:WGPG_TOOL))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
