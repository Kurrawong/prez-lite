<https://w3id.org/ags4/shapes/PIPE-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PIPE_REF ?n1 } || NOT EXISTS { $this ags:PIPE_TOP ?n2 } || NOT EXISTS { $this ags:PIPE_BASE ?n3 }) }\n    ?xother a ags:PIPE .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:PIPE_REF ?a1 } OPTIONAL { ?xother ags:PIPE_REF ?b1 }\n    OPTIONAL { $this ags:PIPE_TOP ?a2 } OPTIONAL { ?xother ags:PIPE_TOP ?b2 }\n    OPTIONAL { $this ags:PIPE_BASE ?a3 } OPTIONAL { ?xother ags:PIPE_BASE ?b3 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\"))\n}" .
<https://w3id.org/ags4/shapes/PIPE-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PIPE-key> <http://www.w3.org/ns/shacl#message> "Another PIPE record has the same combination of KEY fields (LOCA_ID, PIPE_REF, PIPE_TOP, PIPE_BASE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PIPE-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PIPE-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:PIPE_REF ?v1 .\n    $this ags:PIPE_TOP ?v2 .\n    $this ags:PIPE_BASE ?v3 .\n    ?xother ags:PIPE_REF ?v1 .\n    ?xother ags:PIPE_TOP ?v2 .\n    ?xother ags:PIPE_BASE ?v3 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:PIPE }\n}" .
<https://w3id.org/ags4/shapes/PIPE-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PIPE-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/PIPE-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PIPE-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/PIPE-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/PIPE-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/LOCA> .
<https://w3id.org/ags4/shapes/PIPE-parent> <http://www.w3.org/ns/shacl#description> "The LOCA (Location Details) record this PIPE record belongs to (Rule 10c)."@en .
