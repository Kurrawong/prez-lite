<https://w3id.org/ags4/shapes/SCPP-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SCPP-key-null> <http://www.w3.org/ns/shacl#message> "Another SCPP record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCPP_TOP, SCPP_BASE, SCPP_REF): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/SCPP-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SCPP-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SCPG_TESN ?n1 } || NOT EXISTS { $this ags:SCPP_TOP ?n2 } || NOT EXISTS { $this ags:SCPP_BASE ?n3 } || NOT EXISTS { $this ags:SCPP_REF ?n4 }) }\n    ?xother a ags:SCPP .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:SCPG_TESN ?a1 } OPTIONAL { ?xother ags:SCPG_TESN ?b1 }\n    OPTIONAL { $this ags:SCPP_TOP ?a2 } OPTIONAL { ?xother ags:SCPP_TOP ?b2 }\n    OPTIONAL { $this ags:SCPP_BASE ?a3 } OPTIONAL { ?xother ags:SCPP_BASE ?b3 }\n    OPTIONAL { $this ags:SCPP_REF ?a4 } OPTIONAL { ?xother ags:SCPP_REF ?b4 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\"))\n}" .
<https://w3id.org/ags4/shapes/SCPP-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SCPP-key> <http://www.w3.org/ns/shacl#message> "Another SCPP record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCPP_TOP, SCPP_BASE, SCPP_REF): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/SCPP-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SCPP-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:SCPG_TESN ?v1 .\n    $this ags:SCPP_TOP ?v2 .\n    $this ags:SCPP_BASE ?v3 .\n    $this ags:SCPP_REF ?v4 .\n    ?xother ags:SCPP_TOP ?v2 .\n    ?xother ags:SCPP_BASE ?v3 .\n    ?xother ags:SCPP_REF ?v4 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:SCPG_TESN ?v1 }\n    FILTER EXISTS { ?xother a ags:SCPP }\n}" .
<https://w3id.org/ags4/shapes/SCPP-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SCPP-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching SCPG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/SCPP-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SCPP-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:SCPG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/SCPP-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/SCPP-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/SCPG> .
<https://w3id.org/ags4/shapes/SCPP-parent> <http://www.w3.org/ns/shacl#description> "The SCPG (Static Cone Penetration Tests - General) record this SCPP record belongs to (Rule 10c)."@en .
<https://w3id.org/ags4/shapes/SCPP-parent> <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://w3id.org/ags4/shapes/SCPP-parent> <http://www.w3.org/ns/shacl#name> "parent" .
<https://w3id.org/ags4/shapes/SCPP-parent> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/ont/parent> .
<https://w3id.org/ags4/shapes/SCPP-parent> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10c> .
