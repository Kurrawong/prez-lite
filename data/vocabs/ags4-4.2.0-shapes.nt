<https://w3id.org/ags4/shapes/ABBR-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ABBR-key-null> <http://www.w3.org/ns/shacl#message> "Another ABBR record has the same combination of KEY fields (ABBR_HDNG, ABBR_CODE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ABBR-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ABBR-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:ABBR_HDNG ?n0 } || NOT EXISTS { $this ags:ABBR_CODE ?n1 }) }\n    ?xother a ags:ABBR .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:ABBR_HDNG ?a0 } OPTIONAL { ?xother ags:ABBR_HDNG ?b0 }\n    OPTIONAL { $this ags:ABBR_CODE ?a1 } OPTIONAL { ?xother ags:ABBR_CODE ?b1 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\"))\n}" .
<https://w3id.org/ags4/shapes/ABBR-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ABBR-key> <http://www.w3.org/ns/shacl#message> "Another ABBR record has the same combination of KEY fields (ABBR_HDNG, ABBR_CODE): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ABBR-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ABBR-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:ABBR_HDNG ?v0 .\n    $this ags:ABBR_CODE ?v1 .\n    ?xother ags:ABBR_HDNG ?v0 .\n    ?xother ags:ABBR_CODE ?v1 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother a ags:ABBR }\n}" .
