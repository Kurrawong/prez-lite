<https://w3id.org/ags4/shapes/LBST-key-null> <http://www.w3.org/ns/shacl#message> "Another LBST record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, LBSG_REF, LBST_TEST): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/LBST-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/LBST-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:LBSG_REF ?n5 } || NOT EXISTS { $this ags:LBST_TEST ?n6 }) }\n    ?xother a ags:LBST .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }\n    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }\n    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }\n    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }\n    OPTIONAL { $this ags:LBSG_REF ?a5 } OPTIONAL { ?xother ags:LBSG_REF ?b5 }\n    OPTIONAL { $this ags:LBST_TEST ?a6 } OPTIONAL { ?xother ags:LBST_TEST ?b6 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\") && COALESCE(STR(?a5), \"\") = COALESCE(STR(?b5), \"\") && COALESCE(STR(?a6), \"\") = COALESCE(STR(?b6), \"\"))\n}" .
<https://w3id.org/ags4/shapes/LBST-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/LBST-key> <http://www.w3.org/ns/shacl#message> "Another LBST record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, LBSG_REF, LBST_TEST): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/LBST-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/LBST-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:SAMP_TOP ?v1 .\n    $this ags:SAMP_REF ?v2 .\n    $this ags:SAMP_TYPE ?v3 .\n    $this ags:SAMP_ID ?v4 .\n    $this ags:LBSG_REF ?v5 .\n    $this ags:LBST_TEST ?v6 .\n    ?xother ags:LBST_TEST ?v6 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:SAMP_TOP ?v1 }\n    FILTER EXISTS { ?xother ags:SAMP_REF ?v2 }\n    FILTER EXISTS { ?xother ags:SAMP_TYPE ?v3 }\n    FILTER EXISTS { ?xother ags:SAMP_ID ?v4 }\n    FILTER EXISTS { ?xother ags:LBSG_REF ?v5 }\n    FILTER EXISTS { ?xother a ags:LBST }\n}" .
<https://w3id.org/ags4/shapes/LBST-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/LBST-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LBSG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/LBST-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/LBST-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LBSG_REF))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/LBST-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
