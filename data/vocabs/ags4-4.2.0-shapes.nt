<https://w3id.org/ags4/shapes/CBRP-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:SPEC_REF ?n5 } || NOT EXISTS { $this ags:SPEC_DPTH ?n6 } || NOT EXISTS { $this ags:CBRT_TESN ?n7 } || NOT EXISTS { $this ags:CBRP_END ?n8 }) }\n    ?xother a ags:CBRP .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }\n    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }\n    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }\n    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }\n    OPTIONAL { $this ags:SPEC_REF ?a5 } OPTIONAL { ?xother ags:SPEC_REF ?b5 }\n    OPTIONAL { $this ags:SPEC_DPTH ?a6 } OPTIONAL { ?xother ags:SPEC_DPTH ?b6 }\n    OPTIONAL { $this ags:CBRT_TESN ?a7 } OPTIONAL { ?xother ags:CBRT_TESN ?b7 }\n    OPTIONAL { $this ags:CBRP_END ?a8 } OPTIONAL { ?xother ags:CBRP_END ?b8 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\") && COALESCE(STR(?a5), \"\") = COALESCE(STR(?b5), \"\") && COALESCE(STR(?a6), \"\") = COALESCE(STR(?b6), \"\") && COALESCE(STR(?a7), \"\") = COALESCE(STR(?b7), \"\") && COALESCE(STR(?a8), \"\") = COALESCE(STR(?b8), \"\"))\n}" .
<https://w3id.org/ags4/shapes/CBRP-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CBRP-key> <http://www.w3.org/ns/shacl#message> "Another CBRP record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, CBRT_TESN, CBRP_END): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/CBRP-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CBRP-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:SAMP_TOP ?v1 .\n    $this ags:SAMP_REF ?v2 .\n    $this ags:SAMP_TYPE ?v3 .\n    $this ags:SAMP_ID ?v4 .\n    $this ags:SPEC_REF ?v5 .\n    $this ags:SPEC_DPTH ?v6 .\n    $this ags:CBRT_TESN ?v7 .\n    $this ags:CBRP_END ?v8 .\n    ?xother ags:CBRP_END ?v8 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:SAMP_TOP ?v1 }\n    FILTER EXISTS { ?xother ags:SAMP_REF ?v2 }\n    FILTER EXISTS { ?xother ags:SAMP_TYPE ?v3 }\n    FILTER EXISTS { ?xother ags:SAMP_ID ?v4 }\n    FILTER EXISTS { ?xother ags:SPEC_REF ?v5 }\n    FILTER EXISTS { ?xother ags:SPEC_DPTH ?v6 }\n    FILTER EXISTS { ?xother ags:CBRT_TESN ?v7 }\n    FILTER EXISTS { ?xother a ags:CBRP }\n}" .
<https://w3id.org/ags4/shapes/CBRP-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/CBRP-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching CBRT parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/CBRP-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/CBRP-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:SAMP_TOP, ags:SAMP_REF, ags:SAMP_TYPE, ags:SAMP_ID, ags:SPEC_REF, ags:SPEC_DPTH, ags:CBRT_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/CBRP-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/CBRP-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/CBRT> .
<https://w3id.org/ags4/shapes/CBRP-parent> <http://www.w3.org/ns/shacl#description> "The CBRT (California Bearing Ratio Tests - Data) record this CBRP record belongs to (Rule 10c)."@en .
