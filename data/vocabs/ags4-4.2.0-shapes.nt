<https://w3id.org/ags4/shapes/FILE-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FILE-key-null> <http://www.w3.org/ns/shacl#message> "Another FILE record has the same combination of KEY fields (FILE_FSET, FILE_NAME): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/FILE-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FILE-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:FILE_FSET ?n0 } || NOT EXISTS { $this ags:FILE_NAME ?n1 }) }\n    ?xother a ags:FILE .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:FILE_FSET ?a0 } OPTIONAL { ?xother ags:FILE_FSET ?b0 }\n    OPTIONAL { $this ags:FILE_NAME ?a1 } OPTIONAL { ?xother ags:FILE_NAME ?b1 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\"))\n}" .
<https://w3id.org/ags4/shapes/FILE-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FILE-key> <http://www.w3.org/ns/shacl#message> "Another FILE record has the same combination of KEY fields (FILE_FSET, FILE_NAME): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/FILE-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FILE-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:FILE_FSET ?v0 .\n    $this ags:FILE_NAME ?v1 .\n    ?xother ags:FILE_FSET ?v0 .\n    ?xother ags:FILE_NAME ?v1 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother a ags:FILE }\n}" .
