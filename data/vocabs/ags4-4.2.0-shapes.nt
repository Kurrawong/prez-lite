<https://w3id.org/ags4/shapes/FGHI-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/FGHI-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FGHI-key-null> <http://www.w3.org/ns/shacl#message> "Another FGHI record has the same combination of KEY fields (LOCA_ID, FGHG_TOP, FGHG_BASE, FGHG_TESN, FGHI_INST): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/FGHI-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FGHI-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:FGHG_TOP ?n1 } || NOT EXISTS { $this ags:FGHG_BASE ?n2 } || NOT EXISTS { $this ags:FGHG_TESN ?n3 } || NOT EXISTS { $this ags:FGHI_INST ?n4 }) }\n    ?xother a ags:FGHI .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:FGHG_TOP ?a1 } OPTIONAL { ?xother ags:FGHG_TOP ?b1 }\n    OPTIONAL { $this ags:FGHG_BASE ?a2 } OPTIONAL { ?xother ags:FGHG_BASE ?b2 }\n    OPTIONAL { $this ags:FGHG_TESN ?a3 } OPTIONAL { ?xother ags:FGHG_TESN ?b3 }\n    OPTIONAL { $this ags:FGHI_INST ?a4 } OPTIONAL { ?xother ags:FGHI_INST ?b4 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\"))\n}" .
<https://w3id.org/ags4/shapes/FGHI-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FGHI-key> <http://www.w3.org/ns/shacl#message> "Another FGHI record has the same combination of KEY fields (LOCA_ID, FGHG_TOP, FGHG_BASE, FGHG_TESN, FGHI_INST): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/FGHI-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FGHI-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:FGHG_TOP ?v1 .\n    $this ags:FGHG_BASE ?v2 .\n    $this ags:FGHG_TESN ?v3 .\n    $this ags:FGHI_INST ?v4 .\n    ?xother ags:FGHI_INST ?v4 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:FGHG_TOP ?v1 }\n    FILTER EXISTS { ?xother ags:FGHG_BASE ?v2 }\n    FILTER EXISTS { ?xother ags:FGHG_TESN ?v3 }\n    FILTER EXISTS { ?xother a ags:FGHI }\n}" .
<https://w3id.org/ags4/shapes/FGHI-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FGHI-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching FGHG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/FGHI-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FGHI-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:FGHG_TOP, ags:FGHG_BASE, ags:FGHG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
