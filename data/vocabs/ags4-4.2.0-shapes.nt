<https://w3id.org/ags4/shapes/PMTD-PMTG_TESN> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/PMTD-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PMTD-key-null> <http://www.w3.org/ns/shacl#message> "Another PMTD record has the same combination of KEY fields (LOCA_ID, PMTG_DPTH, PMTG_TESN, PMTD_SEQ): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PMTD-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PMTD-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PMTG_DPTH ?n1 } || NOT EXISTS { $this ags:PMTG_TESN ?n2 } || NOT EXISTS { $this ags:PMTD_SEQ ?n3 }) }\n    ?xother a ags:PMTD .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:PMTG_DPTH ?a1 } OPTIONAL { ?xother ags:PMTG_DPTH ?b1 }\n    OPTIONAL { $this ags:PMTG_TESN ?a2 } OPTIONAL { ?xother ags:PMTG_TESN ?b2 }\n    OPTIONAL { $this ags:PMTD_SEQ ?a3 } OPTIONAL { ?xother ags:PMTD_SEQ ?b3 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\"))\n}" .
<https://w3id.org/ags4/shapes/PMTD-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PMTD-key> <http://www.w3.org/ns/shacl#message> "Another PMTD record has the same combination of KEY fields (LOCA_ID, PMTG_DPTH, PMTG_TESN, PMTD_SEQ): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PMTD-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PMTD-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:PMTG_DPTH ?v1 .\n    $this ags:PMTG_TESN ?v2 .\n    $this ags:PMTD_SEQ ?v3 .\n    ?xother ags:PMTD_SEQ ?v3 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:PMTG_DPTH ?v1 }\n    FILTER EXISTS { ?xother ags:PMTG_TESN ?v2 }\n    FILTER EXISTS { ?xother a ags:PMTD }\n}" .
<https://w3id.org/ags4/shapes/PMTD-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PMTD-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching PMTG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/PMTD-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PMTD-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:PMTG_DPTH, ags:PMTG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/PMTD-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
