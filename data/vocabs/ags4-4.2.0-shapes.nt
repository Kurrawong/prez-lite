<https://w3id.org/ags4/shapes/ELRG-key-null> <http://www.w3.org/ns/shacl#message> "Another ELRG record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, ELRG_CODE, ELRG_METH, ELRG_MATX, ELRG_RTYP, ELRG_TADE, ELRG_TICN, ELRG_RUNI): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ELRG-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ELRG-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:SPEC_REF ?n5 } || NOT EXISTS { $this ags:SPEC_DPTH ?n6 } || NOT EXISTS { $this ags:ELRG_CODE ?n7 } || NOT EXISTS { $this ags:ELRG_METH ?n8 } || NOT EXISTS { $this ags:ELRG_MATX ?n9 } || NOT EXISTS { $this ags:ELRG_RTYP ?n10 } || NOT EXISTS { $this ags:ELRG_TADE ?n11 } || NOT EXISTS { $this ags:ELRG_TICN ?n12 } || NOT EXISTS { $this ags:ELRG_RUNI ?n13 }) }\n    ?xother a ags:ELRG .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }\n    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }\n    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }\n    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }\n    OPTIONAL { $this ags:SPEC_REF ?a5 } OPTIONAL { ?xother ags:SPEC_REF ?b5 }\n    OPTIONAL { $this ags:SPEC_DPTH ?a6 } OPTIONAL { ?xother ags:SPEC_DPTH ?b6 }\n    OPTIONAL { $this ags:ELRG_CODE ?a7 } OPTIONAL { ?xother ags:ELRG_CODE ?b7 }\n    OPTIONAL { $this ags:ELRG_METH ?a8 } OPTIONAL { ?xother ags:ELRG_METH ?b8 }\n    OPTIONAL { $this ags:ELRG_MATX ?a9 } OPTIONAL { ?xother ags:ELRG_MATX ?b9 }\n    OPTIONAL { $this ags:ELRG_RTYP ?a10 } OPTIONAL { ?xother ags:ELRG_RTYP ?b10 }\n    OPTIONAL { $this ags:ELRG_TADE ?a11 } OPTIONAL { ?xother ags:ELRG_TADE ?b11 }\n    OPTIONAL { $this ags:ELRG_TICN ?a12 } OPTIONAL { ?xother ags:ELRG_TICN ?b12 }\n    OPTIONAL { $this ags:ELRG_RUNI ?a13 } OPTIONAL { ?xother ags:ELRG_RUNI ?b13 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\") && COALESCE(STR(?a5), \"\") = COALESCE(STR(?b5), \"\") && COALESCE(STR(?a6), \"\") = COALESCE(STR(?b6), \"\") && COALESCE(STR(?a7), \"\") = COALESCE(STR(?b7), \"\") && COALESCE(STR(?a8), \"\") = COALESCE(STR(?b8), \"\") && COALESCE(STR(?a9), \"\") = COALESCE(STR(?b9), \"\") && COALESCE(STR(?a10), \"\") = COALESCE(STR(?b10), \"\") && COALESCE(STR(?a11), \"\") = COALESCE(STR(?b11), \"\") && COALESCE(STR(?a12), \"\") = COALESCE(STR(?b12), \"\") && COALESCE(STR(?a13), \"\") = COALESCE(STR(?b13), \"\"))\n}" .
<https://w3id.org/ags4/shapes/ELRG-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ELRG-key> <http://www.w3.org/ns/shacl#message> "Another ELRG record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, ELRG_CODE, ELRG_METH, ELRG_MATX, ELRG_RTYP, ELRG_TADE, ELRG_TICN, ELRG_RUNI): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ELRG-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ELRG-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:SAMP_TOP ?v1 .\n    $this ags:SAMP_REF ?v2 .\n    $this ags:SAMP_TYPE ?v3 .\n    $this ags:SAMP_ID ?v4 .\n    $this ags:SPEC_REF ?v5 .\n    $this ags:SPEC_DPTH ?v6 .\n    $this ags:ELRG_CODE ?v7 .\n    $this ags:ELRG_METH ?v8 .\n    $this ags:ELRG_MATX ?v9 .\n    $this ags:ELRG_RTYP ?v10 .\n    $this ags:ELRG_TADE ?v11 .\n    $this ags:ELRG_TICN ?v12 .\n    $this ags:ELRG_RUNI ?v13 .\n    ?xother ags:ELRG_CODE ?v7 .\n    ?xother ags:ELRG_METH ?v8 .\n    ?xother ags:ELRG_MATX ?v9 .\n    ?xother ags:ELRG_RTYP ?v10 .\n    ?xother ags:ELRG_TADE ?v11 .\n    ?xother ags:ELRG_TICN ?v12 .\n    ?xother ags:ELRG_RUNI ?v13 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:SAMP_TOP ?v1 }\n    FILTER EXISTS { ?xother ags:SAMP_REF ?v2 }\n    FILTER EXISTS { ?xother ags:SAMP_TYPE ?v3 }\n    FILTER EXISTS { ?xother ags:SAMP_ID ?v4 }\n    FILTER EXISTS { ?xother ags:SPEC_REF ?v5 }\n    FILTER EXISTS { ?xother ags:SPEC_DPTH ?v6 }\n    FILTER EXISTS { ?xother a ags:ELRG }\n}" .
<https://w3id.org/ags4/shapes/ELRG-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ELRG-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching SAMP parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/ELRG-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ELRG-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:SAMP_TOP, ags:SAMP_REF, ags:SAMP_TYPE, ags:SAMP_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/ELRG-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/ELRG-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/SAMP> .
<https://w3id.org/ags4/shapes/ELRG-parent> <http://www.w3.org/ns/shacl#description> "The SAMP (Sample Information) record this ELRG record belongs to (Rule 10c)."@en .
