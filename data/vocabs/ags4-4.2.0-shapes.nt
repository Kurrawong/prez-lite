<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <http://www.w3.org/ns/shacl#order> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/LOCA_ID> .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/ID> .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/LOCA_ID> .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <https://w3id.org/ags4/ont/headingStatus> "*" .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <https://w3id.org/ags4/ont/isKey> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/ISTR-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/ISTR-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ISTR-key-null> <http://www.w3.org/ns/shacl#message> "Another ISTR record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTS_SGLN, ISTR_DPTH, ISTR_REF): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ISTR-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ISTR-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:ISTG_TESN ?n1 } || NOT EXISTS { $this ags:ISTS_SGLN ?n2 } || NOT EXISTS { $this ags:ISTR_DPTH ?n3 } || NOT EXISTS { $this ags:ISTR_REF ?n4 }) }\n    ?xother a ags:ISTR .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:ISTG_TESN ?a1 } OPTIONAL { ?xother ags:ISTG_TESN ?b1 }\n    OPTIONAL { $this ags:ISTS_SGLN ?a2 } OPTIONAL { ?xother ags:ISTS_SGLN ?b2 }\n    OPTIONAL { $this ags:ISTR_DPTH ?a3 } OPTIONAL { ?xother ags:ISTR_DPTH ?b3 }\n    OPTIONAL { $this ags:ISTR_REF ?a4 } OPTIONAL { ?xother ags:ISTR_REF ?b4 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\"))\n}" .
<https://w3id.org/ags4/shapes/ISTR-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ISTR-key> <http://www.w3.org/ns/shacl#message> "Another ISTR record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTS_SGLN, ISTR_DPTH, ISTR_REF): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/ISTR-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ISTR-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:ISTG_TESN ?v1 .\n    $this ags:ISTS_SGLN ?v2 .\n    $this ags:ISTR_DPTH ?v3 .\n    $this ags:ISTR_REF ?v4 .\n    ?xother ags:ISTR_DPTH ?v3 .\n    ?xother ags:ISTR_REF ?v4 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:ISTG_TESN ?v1 }\n    FILTER EXISTS { ?xother ags:ISTS_SGLN ?v2 }\n    FILTER EXISTS { ?xother a ags:ISTR }\n}" .
<https://w3id.org/ags4/shapes/ISTR-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/ISTR-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching ISTS parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/ISTR-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/ISTR-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:ISTG_TESN, ags:ISTS_SGLN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/ISTR-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/ISTR-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/ISTS> .
<https://w3id.org/ags4/shapes/ISTR-parent> <http://www.w3.org/ns/shacl#description> "The ISTS (In Situ Seismic Test - Signal) record this ISTR record belongs to (Rule 10c)."@en .
