<https://w3id.org/ags4/shapes/DMTP-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DMTG_TESN ?n1 } || NOT EXISTS { $this ags:DMTT_DPTH ?n2 }) }\n    ?xother a ags:DMTP .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:DMTG_TESN ?a1 } OPTIONAL { ?xother ags:DMTG_TESN ?b1 }\n    OPTIONAL { $this ags:DMTT_DPTH ?a2 } OPTIONAL { ?xother ags:DMTT_DPTH ?b2 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\"))\n}" .
<https://w3id.org/ags4/shapes/DMTP-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DMTP-key> <http://www.w3.org/ns/shacl#message> "Another DMTP record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMTT_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DMTP-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DMTP-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:DMTG_TESN ?v1 .\n    $this ags:DMTT_DPTH ?v2 .\n    ?xother ags:LOCA_ID ?v0 .\n    ?xother ags:DMTG_TESN ?v1 .\n    ?xother ags:DMTT_DPTH ?v2 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother a ags:DMTP }\n}" .
<https://w3id.org/ags4/shapes/DMTP-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DMTP-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching DMTT parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/DMTP-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DMTP-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:DMTG_TESN, ags:DMTT_DPTH))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/DMTP-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/DMTP-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/DMTT> .
<https://w3id.org/ags4/shapes/DMTP-parent> <http://www.w3.org/ns/shacl#description> "The DMTT (Flat Dilatometer Test - Data) record this DMTP record belongs to (Rule 10c)."@en .
<https://w3id.org/ags4/shapes/DMTP-parent> <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://w3id.org/ags4/shapes/DMTP-parent> <http://www.w3.org/ns/shacl#name> "parent" .
<https://w3id.org/ags4/shapes/DMTP-parent> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/ont/parent> .
<https://w3id.org/ags4/shapes/DMTP-parent> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10c> .
