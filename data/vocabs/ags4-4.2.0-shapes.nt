<https://w3id.org/ags4/shapes/PLTT-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PLTT-key-null> <http://www.w3.org/ns/shacl#message> "Another PLTT record has the same combination of KEY fields (LOCA_ID, PLTG_DPTH, PLTG_TESN, PLTG_CYC, PLTT_STG, PLTT_TIME): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PLTT-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PLTT-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PLTG_DPTH ?n1 } || NOT EXISTS { $this ags:PLTG_TESN ?n2 } || NOT EXISTS { $this ags:PLTG_CYC ?n3 } || NOT EXISTS { $this ags:PLTT_STG ?n4 } || NOT EXISTS { $this ags:PLTT_TIME ?n5 }) }\n    ?xother a ags:PLTT .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:PLTG_DPTH ?a1 } OPTIONAL { ?xother ags:PLTG_DPTH ?b1 }\n    OPTIONAL { $this ags:PLTG_TESN ?a2 } OPTIONAL { ?xother ags:PLTG_TESN ?b2 }\n    OPTIONAL { $this ags:PLTG_CYC ?a3 } OPTIONAL { ?xother ags:PLTG_CYC ?b3 }\n    OPTIONAL { $this ags:PLTT_STG ?a4 } OPTIONAL { ?xother ags:PLTT_STG ?b4 }\n    OPTIONAL { $this ags:PLTT_TIME ?a5 } OPTIONAL { ?xother ags:PLTT_TIME ?b5 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\") && COALESCE(STR(?a5), \"\") = COALESCE(STR(?b5), \"\"))\n}" .
<https://w3id.org/ags4/shapes/PLTT-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PLTT-key> <http://www.w3.org/ns/shacl#message> "Another PLTT record has the same combination of KEY fields (LOCA_ID, PLTG_DPTH, PLTG_TESN, PLTG_CYC, PLTT_STG, PLTT_TIME): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/PLTT-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PLTT-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:PLTG_DPTH ?v1 .\n    $this ags:PLTG_TESN ?v2 .\n    $this ags:PLTG_CYC ?v3 .\n    $this ags:PLTT_STG ?v4 .\n    $this ags:PLTT_TIME ?v5 .\n    ?xother ags:PLTT_STG ?v4 .\n    ?xother ags:PLTT_TIME ?v5 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:PLTG_DPTH ?v1 }\n    FILTER EXISTS { ?xother ags:PLTG_TESN ?v2 }\n    FILTER EXISTS { ?xother ags:PLTG_CYC ?v3 }\n    FILTER EXISTS { ?xother a ags:PLTT }\n}" .
<https://w3id.org/ags4/shapes/PLTT-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/PLTT-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching PLTG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/PLTT-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/PLTT-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:PLTG_DPTH, ags:PLTG_TESN, ags:PLTG_CYC))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/PLTT-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
