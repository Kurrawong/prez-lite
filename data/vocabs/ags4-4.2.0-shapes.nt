<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/LOCA_ID> .
<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/ID> .
<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/LOCA_ID> .
<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <https://w3id.org/ags4/ont/headingStatus> "*" .
<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <https://w3id.org/ags4/ont/isKey> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/FRAC-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/FRAC-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FRAC-key-null> <http://www.w3.org/ns/shacl#message> "Another FRAC record has the same combination of KEY fields (LOCA_ID, FRAC_FROM, FRAC_TO, FRAC_SET): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/FRAC-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FRAC-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:FRAC_FROM ?n1 } || NOT EXISTS { $this ags:FRAC_TO ?n2 } || NOT EXISTS { $this ags:FRAC_SET ?n3 }) }\n    ?xother a ags:FRAC .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:FRAC_FROM ?a1 } OPTIONAL { ?xother ags:FRAC_FROM ?b1 }\n    OPTIONAL { $this ags:FRAC_TO ?a2 } OPTIONAL { ?xother ags:FRAC_TO ?b2 }\n    OPTIONAL { $this ags:FRAC_SET ?a3 } OPTIONAL { ?xother ags:FRAC_SET ?b3 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\"))\n}" .
<https://w3id.org/ags4/shapes/FRAC-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FRAC-key> <http://www.w3.org/ns/shacl#message> "Another FRAC record has the same combination of KEY fields (LOCA_ID, FRAC_FROM, FRAC_TO, FRAC_SET): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/FRAC-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FRAC-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:FRAC_FROM ?v1 .\n    $this ags:FRAC_TO ?v2 .\n    $this ags:FRAC_SET ?v3 .\n    ?xother ags:FRAC_FROM ?v1 .\n    ?xother ags:FRAC_TO ?v2 .\n    ?xother ags:FRAC_SET ?v3 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:FRAC }\n}" .
<https://w3id.org/ags4/shapes/FRAC-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/FRAC-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/FRAC-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/FRAC-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/FRAC-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/FRAC-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/LOCA> .
<https://w3id.org/ags4/shapes/FRAC-parent> <http://www.w3.org/ns/shacl#description> "The LOCA (Location Details) record this FRAC record belongs to (Rule 10c)."@en .
