<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/def/LOCA_ID> .
<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <https://w3id.org/ags4/ont/dataType> <https://w3id.org/ags4/voc/data-types/ID> .
<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <https://w3id.org/ags4/ont/dictionaryEntry> <https://w3id.org/ags4/voc/dictionary/LOCA_ID> .
<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <https://w3id.org/ags4/ont/headingStatus> "*" .
<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <https://w3id.org/ags4/ont/isKey> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <https://w3id.org/ags4/ont/isRequired> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://w3id.org/ags4/shapes/DISC-LOCA_ID> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10a> .
<https://w3id.org/ags4/shapes/DISC-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DISC-key-null> <http://www.w3.org/ns/shacl#message> "Another DISC record has the same combination of KEY fields (LOCA_ID, DISC_TOP, DISC_BASE, FRAC_SET, DISC_NUMB): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DISC-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DISC-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DISC_TOP ?n1 } || NOT EXISTS { $this ags:DISC_BASE ?n2 } || NOT EXISTS { $this ags:FRAC_SET ?n3 } || NOT EXISTS { $this ags:DISC_NUMB ?n4 }) }\n    ?xother a ags:DISC .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:DISC_TOP ?a1 } OPTIONAL { ?xother ags:DISC_TOP ?b1 }\n    OPTIONAL { $this ags:DISC_BASE ?a2 } OPTIONAL { ?xother ags:DISC_BASE ?b2 }\n    OPTIONAL { $this ags:FRAC_SET ?a3 } OPTIONAL { ?xother ags:FRAC_SET ?b3 }\n    OPTIONAL { $this ags:DISC_NUMB ?a4 } OPTIONAL { ?xother ags:DISC_NUMB ?b4 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\"))\n}" .
<https://w3id.org/ags4/shapes/DISC-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DISC-key> <http://www.w3.org/ns/shacl#message> "Another DISC record has the same combination of KEY fields (LOCA_ID, DISC_TOP, DISC_BASE, FRAC_SET, DISC_NUMB): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/DISC-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DISC-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:DISC_TOP ?v1 .\n    $this ags:DISC_BASE ?v2 .\n    $this ags:FRAC_SET ?v3 .\n    $this ags:DISC_NUMB ?v4 .\n    ?xother ags:DISC_TOP ?v1 .\n    ?xother ags:DISC_BASE ?v2 .\n    ?xother ags:DISC_NUMB ?v4 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:FRAC_SET ?v3 }\n    FILTER EXISTS { ?xother a ags:DISC }\n}" .
<https://w3id.org/ags4/shapes/DISC-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/DISC-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/DISC-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/DISC-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/DISC-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
