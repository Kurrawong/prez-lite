<https://w3id.org/ags4/shapes/SAMP-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SAMP-key-null> <http://www.w3.org/ns/shacl#message> "Another SAMP record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/SAMP-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SAMP-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 }) }\n    ?xother a ags:SAMP .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }\n    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }\n    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }\n    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\") && COALESCE(STR(?a3), \"\") = COALESCE(STR(?b3), \"\") && COALESCE(STR(?a4), \"\") = COALESCE(STR(?b4), \"\"))\n}" .
<https://w3id.org/ags4/shapes/SAMP-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SAMP-key> <http://www.w3.org/ns/shacl#message> "Another SAMP record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/SAMP-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SAMP-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:SAMP_TOP ?v1 .\n    $this ags:SAMP_REF ?v2 .\n    $this ags:SAMP_TYPE ?v3 .\n    $this ags:SAMP_ID ?v4 .\n    ?xother ags:SAMP_TOP ?v1 .\n    ?xother ags:SAMP_REF ?v2 .\n    ?xother ags:SAMP_TYPE ?v3 .\n    ?xother ags:SAMP_ID ?v4 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother a ags:SAMP }\n}" .
<https://w3id.org/ags4/shapes/SAMP-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SAMP-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/SAMP-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SAMP-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/SAMP-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/SAMP-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/LOCA> .
<https://w3id.org/ags4/shapes/SAMP-parent> <http://www.w3.org/ns/shacl#description> "The LOCA (Location Details) record this SAMP record belongs to (Rule 10c)."@en .
<https://w3id.org/ags4/shapes/SAMP-parent> <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://w3id.org/ags4/shapes/SAMP-parent> <http://www.w3.org/ns/shacl#name> "parent" .
<https://w3id.org/ags4/shapes/SAMP-parent> <http://www.w3.org/ns/shacl#path> <https://w3id.org/ags4/ont/parent> .
<https://w3id.org/ags4/shapes/SAMP-parent> <https://w3id.org/ags4/ont/rule> <https://w3id.org/ags4/voc/rules/rule-10c> .
<https://w3id.org/ags4/shapes/SAMP> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#NodeShape> .
<https://w3id.org/ags4/shapes/SAMP> <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SAMP> <http://www.w3.org/ns/shacl#description> "Sample Information"@en .
<https://w3id.org/ags4/shapes/SAMP> <http://www.w3.org/ns/shacl#name> "SAMP" .
