agssh:HDIA-key
    a sh:SPARQLConstraint ;
    sh:message "Another HDIA record has the same combination of KEY fields (LOCA_ID, HDIA_DPTH, HDIA_DIAM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:HDIA_DPTH ?v1 .
    $this ags:HDIA_DIAM ?v2 .
    ?xother ags:HDIA_DPTH ?v1 .
    ?xother ags:HDIA_DIAM ?v2 .
