agssh:DMDG-key
    a sh:SPARQLConstraint ;
    sh:message "Another DMDG record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMDG_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DMTG_TESN ?v1 .
    $this ags:DMDG_DPTH ?v2 .
    ?xother ags:DMDG_DPTH ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:DMTG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:DMDG }
}""" ;
.

agssh:DMDG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DMDG record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMDG_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DMTG_TESN ?n1 } || NOT EXISTS { $this ags:DMDG_DPTH ?n2 }) }
    ?xother a ags:DMDG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DMTG_TESN ?a1 } OPTIONAL { ?xother ags:DMTG_TESN ?b1 }
    OPTIONAL { $this ags:DMDG_DPTH ?a2 } OPTIONAL { ?xother ags:DMDG_DPTH ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:DMDG-parent
    a sh:PropertyShape ;
    sh:class ags:DMTG ;
    sh:description "The DMTG (Flat Dilatometer Test - General) record this DMDG record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:DMDG-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching DMTG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:DMTG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

