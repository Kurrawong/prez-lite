agssh:TextOrNumericValue
    a sh:NodeShape ;
    rdfs:isDefinedBy <https://w3id.org/ags4/shapes> ;
    sh:description "A literal of one of the datatypes xsd:string, xsd:decimal, xsd:integer, xsd:double, xsd:float."@en ;
    sh:name "TextOrNumericValue" ;
    sh:nodeKind sh:Literal ;
    sh:or (
        
        [
            sh:datatype xsd:string ;
        ]
        
        [
            sh:datatype xsd:decimal ;
        ]
        
        [
            sh:datatype xsd:integer ;
        ]
        
        [
            sh:datatype xsd:double ;
        ]
        
        [
            sh:datatype xsd:float ;
        ]
    ) ;
