agssh:ISAT-key
    a sh:SPARQLConstraint ;
    sh:message "Another ISAT record has the same combination of KEY fields (LOCA_ID, ISAG_TESN, ISAT_TIME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:ISAG_TESN ?v1 .
    $this ags:ISAT_TIME ?v2 .
    ?xother ags:ISAT_TIME ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:ISAG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:ISAT }
}""" ;
.

agssh:ISAT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another ISAT record has the same combination of KEY fields (LOCA_ID, ISAG_TESN, ISAT_TIME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:ISAG_TESN ?n1 } || NOT EXISTS { $this ags:ISAT_TIME ?n2 }) }
    ?xother a ags:ISAT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:ISAG_TESN ?a1 } OPTIONAL { ?xother ags:ISAG_TESN ?b1 }
    OPTIONAL { $this ags:ISAT_TIME ?a2 } OPTIONAL { ?xother ags:ISAT_TIME ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:ISAT-parent
    a sh:PropertyShape ;
    sh:class ags:ISAG ;
    sh:description "The ISAG (Soakaway Tests - General) record this ISAT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:ISAT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching ISAG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:ISAG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

