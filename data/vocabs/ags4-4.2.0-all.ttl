        <https://w3id.org/ags4/voc/dictionary/LOCA_TERM> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_TRAN> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_TYPE> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_VSSL> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_XTRL> ,
