agssh:TREM-key
    a sh:SPARQLConstraint ;
    sh:message "Another TREM record has the same combination of KEY fields (LOCA_ID, TREM_DTIM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:TREM_DTIM ?v1 .
    ?xother ags:TREM_DTIM ?v1 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:TREM }
}""" ;
.

agssh:TREM-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another TREM record has the same combination of KEY fields (LOCA_ID, TREM_DTIM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:TREM_DTIM ?n1 }) }
    ?xother a ags:TREM .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:TREM_DTIM ?a1 } OPTIONAL { ?xother ags:TREM_DTIM ?b1 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), ""))
}""" ;
.

