        agssh:AAVT-SPEC_REF-type ,
        agssh:AAVT-TEST_STAT ,
        agssh:AAVT-TEST_STAT-type ,
        agssh:AAVT-parent ;
    sh:sparql
        agssh:AAVT-key ,
        agssh:AAVT-key-null ,
        agssh:AAVT-parent-keys ;
    sh:targetClass ags:AAVT ;
    agso:dictionaryEntry <https://w3id.org/ags4/voc/dictionary/AAVT> ;
.

