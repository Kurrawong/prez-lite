        agssh:AAVT-SAMP_ID ,
        agssh:AAVT-SAMP_ID-type ,
        agssh:AAVT-SAMP_REF ,
        agssh:AAVT-SAMP_REF-type ,
        agssh:AAVT-SAMP_TOP ,
        agssh:AAVT-SAMP_TOP-format ,
        agssh:AAVT-SAMP_TOP-type ,
        agssh:AAVT-SAMP_TYPE ,
        agssh:AAVT-SAMP_TYPE-codes ,
        agssh:AAVT-SAMP_TYPE-type ,
        agssh:AAVT-SPEC_BASE ,
        agssh:AAVT-SPEC_BASE-format ,
        agssh:AAVT-SPEC_BASE-type ,
        agssh:AAVT-SPEC_DESC ,
        agssh:AAVT-SPEC_DESC-type ,
