agssh:WGPT-key
    a sh:SPARQLConstraint ;
    sh:message "Another WGPT record has the same combination of KEY fields (LOCA_ID, WGPG_ID, WGPG_TOOL, WGPT_PARA, WGPT_UNIT, WGPT_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:WGPG_ID ?v1 .
    $this ags:WGPG_TOOL ?v2 .
    $this ags:WGPT_PARA ?v3 .
    $this ags:WGPT_UNIT ?v4 .
    $this ags:WGPT_DPTH ?v5 .
    ?xother ags:WGPT_PARA ?v3 .
    ?xother ags:WGPT_UNIT ?v4 .
    ?xother ags:WGPT_DPTH ?v5 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:WGPG_ID ?v1 }
    FILTER EXISTS { ?xother ags:WGPG_TOOL ?v2 }
    FILTER EXISTS { ?xother a ags:WGPT }
}""" ;
.

agssh:WGPT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another WGPT record has the same combination of KEY fields (LOCA_ID, WGPG_ID, WGPG_TOOL, WGPT_PARA, WGPT_UNIT, WGPT_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:WGPG_ID ?n1 } || NOT EXISTS { $this ags:WGPG_TOOL ?n2 } || NOT EXISTS { $this ags:WGPT_PARA ?n3 } || NOT EXISTS { $this ags:WGPT_UNIT ?n4 } || NOT EXISTS { $this ags:WGPT_DPTH ?n5 }) }
    ?xother a ags:WGPT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:WGPG_ID ?a1 } OPTIONAL { ?xother ags:WGPG_ID ?b1 }
    OPTIONAL { $this ags:WGPG_TOOL ?a2 } OPTIONAL { ?xother ags:WGPG_TOOL ?b2 }
    OPTIONAL { $this ags:WGPT_PARA ?a3 } OPTIONAL { ?xother ags:WGPT_PARA ?b3 }
    OPTIONAL { $this ags:WGPT_UNIT ?a4 } OPTIONAL { ?xother ags:WGPT_UNIT ?b4 }
    OPTIONAL { $this ags:WGPT_DPTH ?a5 } OPTIONAL { ?xother ags:WGPT_DPTH ?b5 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), "") && COALESCE(STR(?a5), "") = COALESCE(STR(?b5), ""))
}""" ;
.

agssh:WGPT-parent
    a sh:PropertyShape ;
    sh:class ags:WGPG ;
    sh:description "The WGPG (Wireline Geophysics - General) record this WGPT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:WGPT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching WGPG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:WGPG_ID, ags:WGPG_TOOL))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

