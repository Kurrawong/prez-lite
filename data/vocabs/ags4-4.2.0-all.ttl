agssh:PLTG-key
    a sh:SPARQLConstraint ;
    sh:message "Another PLTG record has the same combination of KEY fields (LOCA_ID, PLTG_DPTH, PLTG_TESN, PLTG_CYC): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PLTG_DPTH ?v1 .
    $this ags:PLTG_TESN ?v2 .
    $this ags:PLTG_CYC ?v3 .
    ?xother ags:PLTG_DPTH ?v1 .
    ?xother ags:PLTG_TESN ?v2 .
    ?xother ags:PLTG_CYC ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:PLTG }
}""" ;
.

agssh:PLTG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PLTG record has the same combination of KEY fields (LOCA_ID, PLTG_DPTH, PLTG_TESN, PLTG_CYC): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PLTG_DPTH ?n1 } || NOT EXISTS { $this ags:PLTG_TESN ?n2 } || NOT EXISTS { $this ags:PLTG_CYC ?n3 }) }
    ?xother a ags:PLTG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PLTG_DPTH ?a1 } OPTIONAL { ?xother ags:PLTG_DPTH ?b1 }
    OPTIONAL { $this ags:PLTG_TESN ?a2 } OPTIONAL { ?xother ags:PLTG_TESN ?b2 }
    OPTIONAL { $this ags:PLTG_CYC ?a3 } OPTIONAL { ?xother ags:PLTG_CYC ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:PLTG-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this PLTG record belongs to (Rule 10c)."@en ;
