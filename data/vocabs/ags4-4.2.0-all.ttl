agssh:DETL-key
    a sh:SPARQLConstraint ;
    sh:message "Another DETL record has the same combination of KEY fields (LOCA_ID, DETL_TOP, DETL_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DETL_TOP ?v1 .
    $this ags:DETL_BASE ?v2 .
    ?xother ags:DETL_TOP ?v1 .
    ?xother ags:DETL_BASE ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:DETL }
}""" ;
.

agssh:DETL-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DETL record has the same combination of KEY fields (LOCA_ID, DETL_TOP, DETL_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DETL_TOP ?n1 } || NOT EXISTS { $this ags:DETL_BASE ?n2 }) }
    ?xother a ags:DETL .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DETL_TOP ?a1 } OPTIONAL { ?xother ags:DETL_TOP ?b1 }
    OPTIONAL { $this ags:DETL_BASE ?a2 } OPTIONAL { ?xother ags:DETL_BASE ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

