    sh:message "CPTT_MAGG: value is not in the suggested format 1DP (1 decimal place). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:CPTT_MAGG ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{1}$" ;
    sh:severity sh:Warning ;
.

agssh:CPTT-CPTT_MAGG-type
    a sh:PropertyShape ;
    sh:message "CPTT_MAGG: value is not of the suggested type 1DP (a number). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:node agssh:NumericValue ;
    sh:path ags:CPTT_MAGG ;
    sh:severity sh:Warning ;
.

