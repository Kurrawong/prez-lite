agssh:PMTP-key
    a sh:SPARQLConstraint ;
    sh:message "Another PMTP record has the same combination of KEY fields (LOCA_ID, PMTG_DPTH, PMTG_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PMTG_DPTH ?v1 .
    $this ags:PMTG_TESN ?v2 .
    ?xother ags:LOCA_ID ?v0 .
    ?xother ags:PMTG_DPTH ?v1 .
    ?xother ags:PMTG_TESN ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:PMTP }
}""" ;
.

agssh:PMTP-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PMTP record has the same combination of KEY fields (LOCA_ID, PMTG_DPTH, PMTG_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PMTG_DPTH ?n1 } || NOT EXISTS { $this ags:PMTG_TESN ?n2 }) }
    ?xother a ags:PMTP .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PMTG_DPTH ?a1 } OPTIONAL { ?xother ags:PMTG_DPTH ?b1 }
    OPTIONAL { $this ags:PMTG_TESN ?a2 } OPTIONAL { ?xother ags:PMTG_TESN ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:PMTP-parent
    a sh:PropertyShape ;
    sh:class ags:PMTG ;
    sh:description "The PMTG (Pressuremeter Test Results - General) record this PMTP record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:PMTP-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching PMTG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:PMTG_DPTH, ags:PMTG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

