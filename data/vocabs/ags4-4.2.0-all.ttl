agssh:IFID-IFID_DPTH-format
    a sh:PropertyShape ;
    sh:message "IFID_DPTH: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:IFID_DPTH ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

