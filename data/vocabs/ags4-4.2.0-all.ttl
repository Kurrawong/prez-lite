agssh:PUMG-key
    a sh:SPARQLConstraint ;
    sh:message "Another PUMG record has the same combination of KEY fields (LOCA_ID, PUMG_TEST): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PUMG_TEST ?v1 .
    ?xother ags:PUMG_TEST ?v1 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:PUMG }
}""" ;
.

agssh:PUMG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PUMG record has the same combination of KEY fields (LOCA_ID, PUMG_TEST): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PUMG_TEST ?n1 }) }
    ?xother a ags:PUMG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PUMG_TEST ?a1 } OPTIONAL { ?xother ags:PUMG_TEST ?b1 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), ""))
}""" ;
.

