agssh:IVAN-IVAN_DPTH-format
    a sh:PropertyShape ;
    sh:message "IVAN_DPTH: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:IVAN_DPTH ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

agssh:IVAN-IVAN_DPTH-type
    a sh:PropertyShape ;
    sh:message "IVAN_DPTH: value is not of the suggested type 2DP (a number). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:node agssh:NumericValue ;
    sh:path ags:IVAN_DPTH ;
    sh:severity sh:Warning ;
.

