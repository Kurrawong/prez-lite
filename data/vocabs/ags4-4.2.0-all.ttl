agssh:ISTR-key
    a sh:SPARQLConstraint ;
    sh:message "Another ISTR record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTS_SGLN, ISTR_DPTH, ISTR_REF): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:ISTG_TESN ?v1 .
    $this ags:ISTS_SGLN ?v2 .
    $this ags:ISTR_DPTH ?v3 .
    $this ags:ISTR_REF ?v4 .
    ?xother ags:ISTR_DPTH ?v3 .
    ?xother ags:ISTR_REF ?v4 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:ISTG_TESN ?v1 }
    FILTER EXISTS { ?xother ags:ISTS_SGLN ?v2 }
    FILTER EXISTS { ?xother a ags:ISTR }
}""" ;
.

agssh:ISTR-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another ISTR record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTS_SGLN, ISTR_DPTH, ISTR_REF): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:ISTG_TESN ?n1 } || NOT EXISTS { $this ags:ISTS_SGLN ?n2 } || NOT EXISTS { $this ags:ISTR_DPTH ?n3 } || NOT EXISTS { $this ags:ISTR_REF ?n4 }) }
    ?xother a ags:ISTR .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:ISTG_TESN ?a1 } OPTIONAL { ?xother ags:ISTG_TESN ?b1 }
    OPTIONAL { $this ags:ISTS_SGLN ?a2 } OPTIONAL { ?xother ags:ISTS_SGLN ?b2 }
    OPTIONAL { $this ags:ISTR_DPTH ?a3 } OPTIONAL { ?xother ags:ISTR_DPTH ?b3 }
    OPTIONAL { $this ags:ISTR_REF ?a4 } OPTIONAL { ?xother ags:ISTR_REF ?b4 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), ""))
}""" ;
.

agssh:ISTR-parent
    a sh:PropertyShape ;
    sh:class ags:ISTS ;
    sh:description "The ISTS (In Situ Seismic Test - Signal) record this ISTR record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:ISTR-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching ISTS parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:ISTG_TESN, ags:ISTS_SGLN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

