<https://w3id.org/ags4/voc/dictionary/FRAC>
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "FRAC"@en ;
    skos:definition "Fracture Spacing"@en ;
    skos:historyNote "AGS 4.1: Group Rule Added - • FRAC_IMAX, FRAC_IAVE, FRAC_IMIN and FRAC_FI should generally be numeric data. A text form shall only be used by addition of a prefixing operator to denote greater than or less than conditions i.e. >200." ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        <https://w3id.org/ags4/voc/dictionary/FILE_FSET> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_FI> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_FROM> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_IAVE> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_IMAX> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_IMIN> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_REM> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_SET> ,
        <https://w3id.org/ags4/voc/dictionary/FRAC_TO> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_ID> ;
    skos:notation "FRAC"^^xsd:token ;
    skos:prefLabel "Fracture Spacing"@en ;
    skos:scopeNote
        """FRAC is used to include fracture spacing derived from rock core, scanline surveys of rock exposures or similar.
It is not typical to define fracture set spacing s as both min/avg/max fracture spacing and Fracture Index. The requirement for one or other should be specified."""@en ,
        "Group rules: FRAC_IMAX, FRAC_IAVE, FRAC_IMIN and FRAC_FI shall generally be numeric data. A text form shall only be used by addition of a prefixing operator to denote greater than or less than conditions i.e. >200 or for 'Not intact' (NI)."@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:FRAC ;
    agso:parentGroup <https://w3id.org/ags4/voc/dictionary/LOCA> ;
.

