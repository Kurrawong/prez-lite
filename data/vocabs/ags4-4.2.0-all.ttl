agssh:DCPT-key
    a sh:SPARQLConstraint ;
    sh:message "Another DCPT record has the same combination of KEY fields (LOCA_ID, DCPG_DATE, DCPG_TESN, DCPG_DPTH, DCPT_CBLO): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DCPG_DATE ?v1 .
    $this ags:DCPG_TESN ?v2 .
    $this ags:DCPG_DPTH ?v3 .
    $this ags:DCPT_CBLO ?v4 .
    ?xother ags:DCPT_CBLO ?v4 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:DCPG_DATE ?v1 }
    FILTER EXISTS { ?xother ags:DCPG_TESN ?v2 }
    FILTER EXISTS { ?xother ags:DCPG_DPTH ?v3 }
    FILTER EXISTS { ?xother a ags:DCPT }
}""" ;
.

agssh:DCPT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DCPT record has the same combination of KEY fields (LOCA_ID, DCPG_DATE, DCPG_TESN, DCPG_DPTH, DCPT_CBLO): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DCPG_DATE ?n1 } || NOT EXISTS { $this ags:DCPG_TESN ?n2 } || NOT EXISTS { $this ags:DCPG_DPTH ?n3 } || NOT EXISTS { $this ags:DCPT_CBLO ?n4 }) }
    ?xother a ags:DCPT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DCPG_DATE ?a1 } OPTIONAL { ?xother ags:DCPG_DATE ?b1 }
    OPTIONAL { $this ags:DCPG_TESN ?a2 } OPTIONAL { ?xother ags:DCPG_TESN ?b2 }
    OPTIONAL { $this ags:DCPG_DPTH ?a3 } OPTIONAL { ?xother ags:DCPG_DPTH ?b3 }
    OPTIONAL { $this ags:DCPT_CBLO ?a4 } OPTIONAL { ?xother ags:DCPT_CBLO ?b4 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), ""))
}""" ;
.

agssh:DCPT-parent
    a sh:PropertyShape ;
    sh:class ags:DCPG ;
    sh:description "The DCPG (Dynamic Cone Penetrometer Tests - General) record this DCPT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:DCPT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching DCPG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:DCPG_DATE, ags:DCPG_TESN, ags:DCPG_DPTH))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

