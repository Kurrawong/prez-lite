    sh:path ags:DICT_UNIT ;
    sh:pattern "^(yyyy\\-mm\\-ddThh:mm:ss\\.sss|yyyy\\-mm\\-ddThh:mm:ss|yyyy\\-mm\\-ddThh:mm|% dry weight|colonies/ml|colonies/l|yyyy\\-mm\\-dd|MPN/100ml|\\(K\\-cm\\)/W|UNITLESS|W/\\(K\\-cm\\)|counts/s|hh:mm:ss|\\(K\\-m\\)/W|W/\\(K\\-m\\)|cm3/MPa|ft2/day|CFU/ml|DegC/W|MPN/ml|W/DegC|ft/min|ft2/yr|kg/cm2|mm/min|mol/kg|%/min|CFU/g|MJ/m3|MN/m2|MPN/l|MPa/m|MPa/s|Mg/m3|ft2/t|g/cm3|hh:mm|kJ/kg|kN/m2|kN/m3|kPa/s|kg/m3|km/hr|l/min|m/day|m/min|m2/MN|m2/yr|mS/cm|mg/kg|mm:ss|month|nT/cm|ohm m|ohmcm|uS/cm|ug/kg|%/hr|%vol|Bq/g|DegC|DegF|acre|cm/s|hect|kg/m|kips|l/hr|m/hr|m3/s|mbar|mg/l|mm/s|ng/l|ppmv|tonf|ug/l|API|GPa|K/W|MPa|N/s|S/m|W/K|Yes|bar|cfs|cm2|cm3|day|deg|ft2|ft3|g/l|gal|gpm|in2|in3|kPa|kgf|km2|ksf|ksi|l/s|lbf|m/s|mgd|mi2|min|mm2|mm3|mph|ohm|pcf|ppb|ppm|psf|psi|rpm|rps|tsf|yd2|yd3|Hz|MJ|MN|Mg|Nm|No|cm|ft|hr|in|kN|kg|km|lb|m2|m3|mD|mV|mi|ml|mm|ms|nT|uT|uV|us|yd|yr|%|N|g|l|m|s|t)$" ;
    sh:severity sh:Warning ;
