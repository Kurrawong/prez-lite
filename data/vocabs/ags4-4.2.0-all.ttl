agssh:PUMT-key
    a sh:SPARQLConstraint ;
    sh:message "Another PUMT record has the same combination of KEY fields (LOCA_ID, PUMG_TEST, PUMT_DTIM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PUMG_TEST ?v1 .
    $this ags:PUMT_DTIM ?v2 .
    ?xother ags:PUMT_DTIM ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:PUMG_TEST ?v1 }
    FILTER EXISTS { ?xother a ags:PUMT }
}""" ;
.

agssh:PUMT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PUMT record has the same combination of KEY fields (LOCA_ID, PUMG_TEST, PUMT_DTIM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PUMG_TEST ?n1 } || NOT EXISTS { $this ags:PUMT_DTIM ?n2 }) }
    ?xother a ags:PUMT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PUMG_TEST ?a1 } OPTIONAL { ?xother ags:PUMG_TEST ?b1 }
    OPTIONAL { $this ags:PUMT_DTIM ?a2 } OPTIONAL { ?xother ags:PUMT_DTIM ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:PUMT-parent
    a sh:PropertyShape ;
    sh:class ags:PUMG ;
    sh:description "The PUMG (Pumping Tests - General) record this PUMT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:PUMT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching PUMG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:PUMG_TEST))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

