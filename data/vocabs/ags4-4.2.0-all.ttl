agssh:TYPE-key
    a sh:SPARQLConstraint ;
    sh:message "Another TYPE record has the same combination of KEY fields (TYPE_TYPE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:TYPE_TYPE ?v0 .
    ?xother ags:TYPE_TYPE ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:TYPE }
}""" ;
.

agssh:TYPE-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another TYPE record has the same combination of KEY fields (TYPE_TYPE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:TYPE_TYPE ?n0 }) }
    ?xother a ags:TYPE .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:TYPE_TYPE ?a0 } OPTIONAL { ?xother ags:TYPE_TYPE ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
.

