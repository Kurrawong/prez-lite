agso:FieldDefinition
    a owl:Class ;
    rdfs:label "field definition"@en ;
    rdfs:comment "The UNIT and TYPE a data file gives for one HEADING of one GROUP (AGS Rule 8). File values are typed using these, not the dictionary's suggested unit and type."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agssh:AAVT-AAVT_AAV
    a sh:PropertyShape ;
    skos:example "8.3" ;
    sh:description "Aggregate Abrasion Value"@en ;
    sh:maxCount 1 ;
    sh:name "AAVT_AAV" ;
    sh:nodeKind sh:Literal ;
    sh:order 10 ;
    sh:path ags:AAVT_AAV ;
    agso:dataType <https://w3id.org/ags4/voc/data-types/2SF> ;
    agso:dictionaryEntry <https://w3id.org/ags4/voc/dictionary/AAVT_AAV> ;
    agso:isKey false ;
    agso:isRequired false ;
.

agssh:AAVT-AAVT_AAV-type
    a sh:PropertyShape ;
    sh:message "AAVT_AAV: value is not of the suggested type 2SF (a number). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:node agssh:NumericValue ;
    sh:path ags:AAVT_AAV ;
    sh:severity sh:Warning ;
.

agssh:AAVT-AAVT_CRED
    a sh:PropertyShape ;
    skos:example "UKAS 0000" ;
    sh:description "Accrediting body and reference number (when appropriate)"@en ;
    sh:maxCount 1 ;
    sh:name "AAVT_CRED" ;
    sh:nodeKind sh:Literal ;
    sh:order 14 ;
    sh:path ags:AAVT_CRED ;
    agso:dataType <https://w3id.org/ags4/voc/data-types/X> ;
    agso:dictionaryEntry <https://w3id.org/ags4/voc/dictionary/AAVT_CRED> ;
    agso:isKey false ;
    agso:isRequired false ;
.

agssh:AAVT-AAVT_CRED-type
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "AAVT_CRED: value is not of the suggested type X (text). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:AAVT_CRED ;
    sh:severity sh:Warning ;
.

agssh:AAVT-AAVT_DEV
    a sh:PropertyShape ;
    skos:example "Explanation of any deviation" ;
    sh:description "Deviation from the specified procedure"@en ;
    sh:maxCount 1 ;
    sh:name "AAVT_DEV" ;
    sh:nodeKind sh:Literal ;
