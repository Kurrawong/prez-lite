agssh:ISTA-key
    a sh:SPARQLConstraint ;
    sh:message "Another ISTA record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTA_TOP, ISTA_BASE, ISTA_ANYN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:ISTG_TESN ?v1 .
    $this ags:ISTA_TOP ?v2 .
    $this ags:ISTA_BASE ?v3 .
    $this ags:ISTA_ANYN ?v4 .
    ?xother ags:ISTA_TOP ?v2 .
    ?xother ags:ISTA_BASE ?v3 .
    ?xother ags:ISTA_ANYN ?v4 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:ISTG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:ISTA }
}""" ;
.

agssh:ISTA-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another ISTA record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTA_TOP, ISTA_BASE, ISTA_ANYN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:ISTG_TESN ?n1 } || NOT EXISTS { $this ags:ISTA_TOP ?n2 } || NOT EXISTS { $this ags:ISTA_BASE ?n3 } || NOT EXISTS { $this ags:ISTA_ANYN ?n4 }) }
    ?xother a ags:ISTA .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:ISTG_TESN ?a1 } OPTIONAL { ?xother ags:ISTG_TESN ?b1 }
    OPTIONAL { $this ags:ISTA_TOP ?a2 } OPTIONAL { ?xother ags:ISTA_TOP ?b2 }
    OPTIONAL { $this ags:ISTA_BASE ?a3 } OPTIONAL { ?xother ags:ISTA_BASE ?b3 }
    OPTIONAL { $this ags:ISTA_ANYN ?a4 } OPTIONAL { ?xother ags:ISTA_ANYN ?b4 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), ""))
}""" ;
.

agssh:ISTA-parent
    a sh:PropertyShape ;
    sh:class ags:ISTG ;
    sh:description "The ISTG (In Situ Seismic Test - General) record this ISTA record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:ISTA-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching ISTG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:ISTG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

