agssh:DMTZ-key
    a sh:SPARQLConstraint ;
    sh:message "Another DMTZ record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMTZ_DATE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DMTG_TESN ?v1 .
    $this ags:DMTZ_DATE ?v2 .
    ?xother ags:DMTZ_DATE ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:DMTG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:DMTZ }
}""" ;
.

agssh:DMTZ-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DMTZ record has the same combination of KEY fields (LOCA_ID, DMTG_TESN, DMTZ_DATE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DMTG_TESN ?n1 } || NOT EXISTS { $this ags:DMTZ_DATE ?n2 }) }
    ?xother a ags:DMTZ .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DMTG_TESN ?a1 } OPTIONAL { ?xother ags:DMTG_TESN ?b1 }
    OPTIONAL { $this ags:DMTZ_DATE ?a2 } OPTIONAL { ?xother ags:DMTZ_DATE ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

