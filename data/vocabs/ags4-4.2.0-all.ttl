<https://w3id.org/ags4/voc/dictionary/TRAN>
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "TRAN"@en ;
    skos:definition "Data File Transmission Information / Data Status"@en ;
    skos:historyNote "Group status: Required in all files (Rule 14)" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        <https://w3id.org/ags4/voc/dictionary/FILE_FSET> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_AGS> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_DATE> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_DESC> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_DLIM> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_ISNO> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_PROD> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_RCON> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_RECV> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_REM> ,
        <https://w3id.org/ags4/voc/dictionary/TRAN_STAT> ;
    skos:notation "TRAN"^^xsd:token ;
    skos:prefLabel "Data File Transmission Information / Data Status"@en ;
    skos:scopeNote """TRAN is required in all AGS4 files (Rule 14)
TRAN_DLIM shall be included if record linking is used. If TRAN_DLIM is not defined, the default shall be a | (pipe symbol).
TRAN_RCON shall be included if record linking is used. If TRAN_RCON is not defined, the default shall be a + .
Delimiter and concatenator characters (TRAN_DLIM & TRAN_RCON) need to be defined if Record Link data or multiple concatenated abbreviations are included in the file. These characters cannot be used in IDs and abbreviations that are referred to in data key sets."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:TRAN ;
.

