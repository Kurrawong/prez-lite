agssh:PROJ-key
    a sh:SPARQLConstraint ;
    sh:message "Another PROJ record has the same combination of KEY fields (PROJ_ID): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:PROJ_ID ?v0 .
    ?xother ags:PROJ_ID ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:PROJ }
}""" ;
.

agssh:PROJ-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PROJ record has the same combination of KEY fields (PROJ_ID): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:PROJ_ID ?n0 }) }
    ?xother a ags:PROJ .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:PROJ_ID ?a0 } OPTIONAL { ?xother ags:PROJ_ID ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
.

agssh:PROJ-single-row
    a sh:SPARQLConstraint ;
    sh:message "A data file shall contain only one PROJ data row (Rule 13)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?other WHERE {
    ?other a ags:PROJ .
    FILTER (?other != $this)
}""" ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-13> ;
.

