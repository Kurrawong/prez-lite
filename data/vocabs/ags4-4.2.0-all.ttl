agssh:IRDX-key
    a sh:SPARQLConstraint ;
    sh:message "Another IRDX record has the same combination of KEY fields (LOCA_ID, IRDX_DPTH, IRDX_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:IRDX_DPTH ?v1 .
    $this ags:IRDX_TESN ?v2 .
    ?xother ags:IRDX_DPTH ?v1 .
    ?xother ags:IRDX_TESN ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:IRDX }
}""" ;
.

agssh:IRDX-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another IRDX record has the same combination of KEY fields (LOCA_ID, IRDX_DPTH, IRDX_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:IRDX_DPTH ?n1 } || NOT EXISTS { $this ags:IRDX_TESN ?n2 }) }
    ?xother a ags:IRDX .
