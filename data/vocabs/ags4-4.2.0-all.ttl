agssh:PLTT-key
    a sh:SPARQLConstraint ;
    sh:message "Another PLTT record has the same combination of KEY fields (LOCA_ID, PLTG_DPTH, PLTG_TESN, PLTG_CYC, PLTT_STG, PLTT_TIME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PLTG_DPTH ?v1 .
    $this ags:PLTG_TESN ?v2 .
    $this ags:PLTG_CYC ?v3 .
    $this ags:PLTT_STG ?v4 .
    $this ags:PLTT_TIME ?v5 .
    ?xother ags:PLTT_STG ?v4 .
    ?xother ags:PLTT_TIME ?v5 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:PLTG_DPTH ?v1 }
    FILTER EXISTS { ?xother ags:PLTG_TESN ?v2 }
    FILTER EXISTS { ?xother ags:PLTG_CYC ?v3 }
    FILTER EXISTS { ?xother a ags:PLTT }
}""" ;
.

agssh:PLTT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PLTT record has the same combination of KEY fields (LOCA_ID, PLTG_DPTH, PLTG_TESN, PLTG_CYC, PLTT_STG, PLTT_TIME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PLTG_DPTH ?n1 } || NOT EXISTS { $this ags:PLTG_TESN ?n2 } || NOT EXISTS { $this ags:PLTG_CYC ?n3 } || NOT EXISTS { $this ags:PLTT_STG ?n4 } || NOT EXISTS { $this ags:PLTT_TIME ?n5 }) }
    ?xother a ags:PLTT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PLTG_DPTH ?a1 } OPTIONAL { ?xother ags:PLTG_DPTH ?b1 }
    OPTIONAL { $this ags:PLTG_TESN ?a2 } OPTIONAL { ?xother ags:PLTG_TESN ?b2 }
    OPTIONAL { $this ags:PLTG_CYC ?a3 } OPTIONAL { ?xother ags:PLTG_CYC ?b3 }
    OPTIONAL { $this ags:PLTT_STG ?a4 } OPTIONAL { ?xother ags:PLTT_STG ?b4 }
    OPTIONAL { $this ags:PLTT_TIME ?a5 } OPTIONAL { ?xother ags:PLTT_TIME ?b5 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), "") && COALESCE(STR(?a5), "") = COALESCE(STR(?b5), ""))
}""" ;
.

