    sh:pattern "^(CONCB|CONCC|SPTLS|AMAL|COMP|BLK|CBR|MOS|ES|EW|LB|TW|UT|B|C|D|G|L|M|P|U|W)(\\+(CONCB|CONCC|SPTLS|AMAL|COMP|BLK|CBR|MOS|ES|EW|LB|TW|UT|B|C|D|G|L|M|P|U|W))*$" ;
    sh:severity sh:Warning ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-16> ;
.

