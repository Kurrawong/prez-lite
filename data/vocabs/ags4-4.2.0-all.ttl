    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "ECTN"@en ;
    skos:definition "Sample Container Details"@en ;
    skos:historyNote """Group status: New
AGS 4.1: Group Added
AGS 4.1: Headings Added - LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, ECTN_ID, ECTN_TYPE, ECTN_REM, FILE_FSET
AGS 4.1: Group Rule Added - • When the sample is contained in a single container the sample shall not be reported in this group.""" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        <https://w3id.org/ags4/voc/dictionary/ECTN_ID> ,
        <https://w3id.org/ags4/voc/dictionary/ECTN_REM> ,
        <https://w3id.org/ags4/voc/dictionary/ECTN_TYPE> ,
        <https://w3id.org/ags4/voc/dictionary/FILE_FSET> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_ID> ,
        <https://w3id.org/ags4/voc/dictionary/SAMP_ID> ,
        <https://w3id.org/ags4/voc/dictionary/SAMP_REF> ,
        <https://w3id.org/ags4/voc/dictionary/SAMP_TOP> ,
        <https://w3id.org/ags4/voc/dictionary/SAMP_TYPE> ;
    skos:notation "ECTN"^^xsd:token ;
    skos:prefLabel "Sample Container Details"@en ;
    skos:scopeNote
        "Group rules: When the sample is contained in a single container the sample shall not be reported in this group."@en ,
        """The ECTN group is used to record details of multiple containers forming part of any single sample. For example, a selection of glass jars, vials, tubs etc (comprising a single ES sample) taken for contamination testing, or multiple small bulk bags in lieu of a single large bulk for geotechnical testing (comprising a single LB sample).
SAMP_ID does not have to be used and can be NULL (Rule 12); the remaining keyset data field headings can be used on their own."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:ECTN ;
    agso:parentGroup <https://w3id.org/ags4/voc/dictionary/SAMP> ;
.

