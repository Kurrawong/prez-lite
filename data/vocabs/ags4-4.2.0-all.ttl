<https://w3id.org/ags4/voc/data-types/nSF>
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "nSF"@en ;
    skos:definition "Value with required number of significant figures. e.g. 2SF = 2 significant figures = 1.2, 10"@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:narrower
        <https://w3id.org/ags4/voc/data-types/1SF> ,
        <https://w3id.org/ags4/voc/data-types/2SF> ,
        <https://w3id.org/ags4/voc/data-types/3SF> ;
    skos:notation "nSF"^^xsd:token ;
    skos:prefLabel "Value with required number of significant figures"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

<https://w3id.org/ags4/voc/rules/rule-10>
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/rules> ;
    skos:definition """HEADINGs are defined as KEY, REQUIRED or OTHER.
• KEY fields are necessary to uniquely define the data.
• REQUIRED fields are necessary to allow interpretation of the data file.
• OTHER fields are included depending on the scope of the data file and availability of data to be included."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/rules> ;
    skos:narrower
        <https://w3id.org/ags4/voc/rules/rule-10a> ,
        <https://w3id.org/ags4/voc/rules/rule-10b> ,
        <https://w3id.org/ags4/voc/rules/rule-10c> ;
    skos:notation "10"^^xsd:token ;
    skos:prefLabel "Rule 10"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/rules> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/rules.json> ;
    schema:status status:stable ;
.

<https://w3id.org/ags4/voc/rules/rule-11>
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/rules> ;
    skos:definition """HEADINGs defined as a data TYPE of 'Record Link' (RL) can be used to link data rows to entries in GROUPs outside of the defined hierarchy (Rule 10c) or DICT group for user defined GROUPs.
The GROUP name followed by the KEY FIELDs defining the cross-referenced data row, in the order presented in the AGS4 DATA DICTIONARY."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/rules> ;
    skos:narrower
        <https://w3id.org/ags4/voc/rules/rule-11a> ,
        <https://w3id.org/ags4/voc/rules/rule-11b> ,
        <https://w3id.org/ags4/voc/rules/rule-11c> ;
    skos:notation "11"^^xsd:token ;
    skos:prefLabel "Rule 11"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/rules> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/rules.json> ;
    schema:status status:stable ;
.

<https://w3id.org/ags4/voc/rules/rule-19>
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/rules> ;
    skos:definition "A GROUP name shall not be more than 4 characters long and shall consist of uppercase letters and numbers only."@en ;
    skos:inScheme <https://w3id.org/ags4/voc/rules> ;
    skos:narrower
        <https://w3id.org/ags4/voc/rules/rule-19a> ,
        <https://w3id.org/ags4/voc/rules/rule-19b> ;
    skos:notation "19"^^xsd:token ;
    skos:prefLabel "Rule 19"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/rules> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/rules.json> ;
    schema:status status:stable ;
.

<https://w3id.org/ags4/voc/units/MJ_per_m3>
    a skos:Concept ;
