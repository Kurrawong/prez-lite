    skos:definition "Wireline Geophysics - Readings"@en ;
    skos:historyNote """Group status: New
AGS 4.1: Group Added
AGS 4.1: Headings Added - LOCA_ID, WGPG_ID, WGPG_TOOL, WGPG_PARA, WGPG_UNIT, WGPT_DPTH, WGPT_RDNG, WGPT_CAS, WGPT_REM, FILE_FSET""" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        <https://w3id.org/ags4/voc/dictionary/FILE_FSET> ,
        <https://w3id.org/ags4/voc/dictionary/LOCA_ID> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_ID> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_TOOL> ,
        <https://w3id.org/ags4/voc/dictionary/WGPT_CAS> ,
        <https://w3id.org/ags4/voc/dictionary/WGPT_DPTH> ,
        <https://w3id.org/ags4/voc/dictionary/WGPT_PARA> ,
        <https://w3id.org/ags4/voc/dictionary/WGPT_RDNG> ,
