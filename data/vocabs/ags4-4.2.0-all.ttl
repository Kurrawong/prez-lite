agssh:FGHS-key
    a sh:SPARQLConstraint ;
    sh:message "Another FGHS record has the same combination of KEY fields (LOCA_ID, FGHG_TOP, FGHG_BASE, FGHG_TESN, FGHS_STG): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:FGHG_TOP ?v1 .
    $this ags:FGHG_BASE ?v2 .
    $this ags:FGHG_TESN ?v3 .
    $this ags:FGHS_STG ?v4 .
    ?xother ags:FGHS_STG ?v4 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:FGHG_TOP ?v1 }
    FILTER EXISTS { ?xother ags:FGHG_BASE ?v2 }
    FILTER EXISTS { ?xother ags:FGHG_TESN ?v3 }
    FILTER EXISTS { ?xother a ags:FGHS }
}""" ;
.

agssh:FGHS-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another FGHS record has the same combination of KEY fields (LOCA_ID, FGHG_TOP, FGHG_BASE, FGHG_TESN, FGHS_STG): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:FGHG_TOP ?n1 } || NOT EXISTS { $this ags:FGHG_BASE ?n2 } || NOT EXISTS { $this ags:FGHG_TESN ?n3 } || NOT EXISTS { $this ags:FGHS_STG ?n4 }) }
    ?xother a ags:FGHS .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:FGHG_TOP ?a1 } OPTIONAL { ?xother ags:FGHG_TOP ?b1 }
    OPTIONAL { $this ags:FGHG_BASE ?a2 } OPTIONAL { ?xother ags:FGHG_BASE ?b2 }
    OPTIONAL { $this ags:FGHG_TESN ?a3 } OPTIONAL { ?xother ags:FGHG_TESN ?b3 }
    OPTIONAL { $this ags:FGHS_STG ?a4 } OPTIONAL { ?xother ags:FGHS_STG ?b4 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), ""))
}""" ;
.

agssh:FGHS-parent
    a sh:PropertyShape ;
    sh:class ags:FGHG ;
    sh:description "The FGHG (Field Geohydraulic Testing - General) record this FGHS record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:FGHS-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching FGHG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:FGHG_TOP, ags:FGHG_BASE, ags:FGHG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

