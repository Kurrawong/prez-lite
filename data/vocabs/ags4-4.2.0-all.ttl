    agso:abbreviationList <https://w3id.org/ags4/voc/abbreviations/DICT_TYPE> ;
    agso:dataType <https://w3id.org/ags4/voc/data-types/PA> ;
    agso:dictionaryEntry <https://w3id.org/ags4/voc/dictionary/DICT_TYPE> ;
    agso:headingStatus "*R" ;
    agso:isKey true ;
    agso:isRequired true ;
    agso:rule
        <https://w3id.org/ags4/voc/rules/rule-10a> ,
        <https://w3id.org/ags4/voc/rules/rule-10b> ;
.

agssh:DICT-DICT_TYPE-codes
    a sh:PropertyShape ;
    sh:message "DICT_TYPE: value is not a standard AGS 4.2.0 abbreviation for DICT_TYPE. Non-standard values must be defined in the file (Rule 16)." ;
    sh:path ags:DICT_TYPE ;
    sh:pattern "^(HEADING|GROUP)(\\+(HEADING|GROUP))*$" ;
    sh:severity sh:Warning ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-16> ;
.

agssh:DICT-DICT_TYPE-type
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "DICT_TYPE: value is not of the suggested type PA (text). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:DICT_TYPE ;
    sh:severity sh:Warning ;
.

agssh:DICT-DICT_UNIT
    a sh:PropertyShape ;
    skos:example "mg/kg" ;
    sh:description "Units (Note: This data is REQUIRED where DICT_TYPE='HEADING')"@en ;
