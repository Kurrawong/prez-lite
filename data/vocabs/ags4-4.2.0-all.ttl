    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "WGPG"@en ;
    skos:definition "Wireline Geophysics - General"@en ;
    skos:historyNote """Group status: New
AGS 4.1: Group Added
AGS 4.1: Headings Added - LOCA_ID, WGPG_ID, WGPG_TOOL, WGPG_DATE, WGPG_STRT, WGPG_STOP, WGPG_BHD, WGPG_WAT, WGPG_DETL, WGPG_METH, WGPG_LIM, WGPG_ULIM, WGPG_CRED, WGPG_ENV, WGPG_CONT, WGPG_CASD, WGPG_STAT, WGPG_REM, FILE_FSET""" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        <https://w3id.org/ags4/voc/dictionary/FILE_FSET> ,
