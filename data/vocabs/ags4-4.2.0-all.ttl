    sh:message "PTST_BVAL: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:PTST_BVAL ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

agssh:PTST-PTST_BVAL-type
    a sh:PropertyShape ;
    sh:message "PTST_BVAL: value is not of the suggested type 2DP (a number). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:node agssh:NumericValue ;
    sh:path ags:PTST_BVAL ;
    sh:severity sh:Warning ;
.

