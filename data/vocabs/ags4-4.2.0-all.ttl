    sh:select """SELECT $this ?xother WHERE {
    $this ags:UNIT_UNIT ?v0 .
    ?xother ags:UNIT_UNIT ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:UNIT }
}""" ;
.

agssh:UNIT-key-null
    a sh:SPARQLConstraint ;
