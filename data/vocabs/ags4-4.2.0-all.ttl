agssh:IFID-key
    a sh:SPARQLConstraint ;
    sh:message "Another IFID record has the same combination of KEY fields (LOCA_ID, IFID_DPTH, IFID_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:IFID_DPTH ?v1 .
    $this ags:IFID_TESN ?v2 .
    ?xother ags:IFID_DPTH ?v1 .
    ?xother ags:IFID_TESN ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:IFID }
}""" ;
.

agssh:IFID-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another IFID record has the same combination of KEY fields (LOCA_ID, IFID_DPTH, IFID_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:IFID_DPTH ?n1 } || NOT EXISTS { $this ags:IFID_TESN ?n2 }) }
    ?xother a ags:IFID .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:IFID_DPTH ?a1 } OPTIONAL { ?xother ags:IFID_DPTH ?b1 }
    OPTIONAL { $this ags:IFID_TESN ?a2 } OPTIONAL { ?xother ags:IFID_TESN ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

