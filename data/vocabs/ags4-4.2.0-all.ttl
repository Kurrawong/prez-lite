    sh:message "SAMP_TYPE: value is not a standard AGS 4.2.0 abbreviation for SAMP_TYPE. Non-standard values must be defined in the file (Rule 16)." ;
    sh:path ags:SAMP_TYPE ;
    sh:pattern "^(CONCB|CONCC|SPTLS|AMAL|COMP|BLK|CBR|MOS|ES|EW|LB|TW|UT|B|C|D|G|L|M|P|U|W)(\\+(CONCB|CONCC|SPTLS|AMAL|COMP|BLK|CBR|MOS|ES|EW|LB|TW|UT|B|C|D|G|L|M|P|U|W))*$" ;
    sh:severity sh:Warning ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-16> ;
.

agssh:ALOS-SAMP_TYPE-type
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "SAMP_TYPE: value is not of the suggested type PA (text). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:SAMP_TYPE ;
    sh:severity sh:Warning ;
.

