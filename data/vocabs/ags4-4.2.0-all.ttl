agssh:LBSG-key
    a sh:SPARQLConstraint ;
    sh:message "Another LBSG record has the same combination of KEY fields (LBSG_REF): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LBSG_REF ?v0 .
    ?xother ags:LBSG_REF ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:LBSG }
}""" ;
.

agssh:LBSG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another LBSG record has the same combination of KEY fields (LBSG_REF): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LBSG_REF ?n0 }) }
    ?xother a ags:LBSG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LBSG_REF ?a0 } OPTIONAL { ?xother ags:LBSG_REF ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
.

