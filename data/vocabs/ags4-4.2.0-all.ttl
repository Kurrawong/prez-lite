        <https://w3id.org/ags4/voc/dictionary/WGPG_CONT> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_CRED> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_DATE> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_DETL> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_ENV> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_ID> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_METH> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_OPER> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_REM> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_STAT> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_STOP> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_STRT> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_TOOL> ,
        <https://w3id.org/ags4/voc/dictionary/WGPG_WAT> ;
    skos:notation "WGPG"^^xsd:token ;
    skos:prefLabel "Wireline Geophysics - General"@en ;
    skos:scopeNote """WGPG_TOOL abbreviations could be the name of the test reference. Examples of WGPG_CODE include: SGR Spectral Gamma, CAL3 3 arm calliper.
Good practice dictates that Instrument method, upper reading detection limits are provided as part of the appendix of the test.
WGPG_CDIA is intentionally a text field recording the information provided to the wireline surveyors from the drilling operations to compare it to the information reported in CDIA (Casing Diameter by Depth) group.
WGPG_STRT shall report the test top depth and WGPG_STOP shall report the base depth, irrespective of direction the test was run.
Equipment data sheets shall be added in FILE_FSET."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:WGPG ;
    agso:parentGroup <https://w3id.org/ags4/voc/dictionary/LOCA> ;
.

