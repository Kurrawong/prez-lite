    sh:message "FGHG_CNFG: value is not a standard AGS 4.2.0 abbreviation for FGHG_CNFG. Non-standard values must be defined in the file (Rule 16)." ;
    sh:path ags:FGHG_CNFG ;
    sh:pattern "^(PKSD|PKSI|SPIE|PKD|PKS|BH|SP)(\\+(PKSD|PKSI|SPIE|PKD|PKS|BH|SP))*$" ;
    sh:severity sh:Warning ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-16> ;
.

agssh:FGHG-FGHG_CNFG-type
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "FGHG_CNFG: value is not of the suggested type PA (text). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:FGHG_CNFG ;
    sh:severity sh:Warning ;
.

