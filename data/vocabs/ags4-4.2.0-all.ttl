agssh:MCVT-SAMP_TOP-format
    a sh:PropertyShape ;
    sh:message "SAMP_TOP: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:SAMP_TOP ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

