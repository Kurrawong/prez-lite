agssh:PMMD-key
    a sh:SPARQLConstraint ;
    sh:message "Another PMMD record has the same combination of KEY fields (LOCA_ID, PMMG_DPTH, PMMG_TESN, PMMD_SEQ): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PMMG_DPTH ?v1 .
    $this ags:PMMG_TESN ?v2 .
    $this ags:PMMD_SEQ ?v3 .
    ?xother ags:PMMD_SEQ ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:PMMG_DPTH ?v1 }
    FILTER EXISTS { ?xother ags:PMMG_TESN ?v2 }
    FILTER EXISTS { ?xother a ags:PMMD }
}""" ;
.

agssh:PMMD-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PMMD record has the same combination of KEY fields (LOCA_ID, PMMG_DPTH, PMMG_TESN, PMMD_SEQ): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PMMG_DPTH ?n1 } || NOT EXISTS { $this ags:PMMG_TESN ?n2 } || NOT EXISTS { $this ags:PMMD_SEQ ?n3 }) }
    ?xother a ags:PMMD .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PMMG_DPTH ?a1 } OPTIONAL { ?xother ags:PMMG_DPTH ?b1 }
    OPTIONAL { $this ags:PMMG_TESN ?a2 } OPTIONAL { ?xother ags:PMMG_TESN ?b2 }
    OPTIONAL { $this ags:PMMD_SEQ ?a3 } OPTIONAL { ?xother ags:PMMD_SEQ ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:PMMD-parent
    a sh:PropertyShape ;
    sh:class ags:PMMG ;
    sh:description "The PMMG (Menard Pressuremeter Test Results - General) record this PMMD record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:PMMD-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching PMMG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:PMMG_DPTH, ags:PMMG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

