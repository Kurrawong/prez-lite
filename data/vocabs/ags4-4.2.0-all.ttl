agssh:CPTM-key
    a sh:SPARQLConstraint ;
    sh:message "Another CPTM record has the same combination of KEY fields (LOCA_ID, CPTM_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:CPTM_DPTH ?v1 .
    ?xother ags:CPTM_DPTH ?v1 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:CPTM }
}""" ;
.

agssh:CPTM-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another CPTM record has the same combination of KEY fields (LOCA_ID, CPTM_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:CPTM_DPTH ?n1 }) }
    ?xother a ags:CPTM .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:CPTM_DPTH ?a1 } OPTIONAL { ?xother ags:CPTM_DPTH ?b1 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), ""))
}""" ;
.

agssh:CPTM-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this CPTM record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:CPTM-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

