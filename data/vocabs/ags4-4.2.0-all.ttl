agssh:CPTT-key
    a sh:SPARQLConstraint ;
    sh:message "Another CPTT record has the same combination of KEY fields (LOCA_ID, CPTG_TESN, CPTT_REDN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:CPTG_TESN ?v1 .
    $this ags:CPTT_REDN ?v2 .
    ?xother ags:CPTT_REDN ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:CPTG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:CPTT }
}""" ;
.

agssh:CPTT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another CPTT record has the same combination of KEY fields (LOCA_ID, CPTG_TESN, CPTT_REDN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:CPTG_TESN ?n1 } || NOT EXISTS { $this ags:CPTT_REDN ?n2 }) }
    ?xother a ags:CPTT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:CPTG_TESN ?a1 } OPTIONAL { ?xother ags:CPTG_TESN ?b1 }
    OPTIONAL { $this ags:CPTT_REDN ?a2 } OPTIONAL { ?xother ags:CPTT_REDN ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:CPTT-parent
    a sh:PropertyShape ;
    sh:class ags:CPTG ;
    sh:description "The CPTG (Cone Penetration Test (CPT/CPTu) - General) record this CPTT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:CPTT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching CPTG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:CPTG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

