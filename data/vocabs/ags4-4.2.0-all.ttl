    ) ;
.

agssh:YesNoValue
    a sh:NodeShape ;
    rdfs:isDefinedBy <https://w3id.org/ags4/shapes> ;
    sh:description "A literal of one of the datatypes xsd:string, xsd:boolean, with a value in ['Y', 'N']."@en ;
