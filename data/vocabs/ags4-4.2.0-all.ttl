    sh:message "CTRP_ACVS: value is not in the suggested format 1DP (1 decimal place). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:CTRP_ACVS ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{1}$" ;
    sh:severity sh:Warning ;
.

