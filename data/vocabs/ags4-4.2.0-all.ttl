        <https://w3id.org/ags4/voc/dictionary/PMTG_TESN> ,
        <https://w3id.org/ags4/voc/dictionary/PMTG_TOPP> ,
        <https://w3id.org/ags4/voc/dictionary/PMTG_TRST> ,
        <https://w3id.org/ags4/voc/dictionary/PMTG_TYPE> ,
