        <https://w3id.org/ags4/voc/dictionary/GCHM_IREF> ,
        <https://w3id.org/ags4/voc/dictionary/GCHM_ITYP> ,
        <https://w3id.org/ags4/voc/dictionary/GCHM_LAB> ,
        <https://w3id.org/ags4/voc/dictionary/GCHM_LSID> ,
        <https://w3id.org/ags4/voc/dictionary/GCHM_METH> ,
        <https://w3id.org/ags4/voc/dictionary/GCHM_NAME> ,
