agssh:ISTS-key
    a sh:SPARQLConstraint ;
    sh:message "Another ISTS record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTS_SGLN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:ISTG_TESN ?v1 .
    $this ags:ISTS_SGLN ?v2 .
    ?xother ags:ISTS_SGLN ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:ISTG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:ISTS }
}""" ;
.

agssh:ISTS-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another ISTS record has the same combination of KEY fields (LOCA_ID, ISTG_TESN, ISTS_SGLN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:ISTG_TESN ?n1 } || NOT EXISTS { $this ags:ISTS_SGLN ?n2 }) }
    ?xother a ags:ISTS .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:ISTG_TESN ?a1 } OPTIONAL { ?xother ags:ISTG_TESN ?b1 }
    OPTIONAL { $this ags:ISTS_SGLN ?a2 } OPTIONAL { ?xother ags:ISTS_SGLN ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

