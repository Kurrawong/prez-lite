    sh:message "CTRG_SBP: value is not in the suggested format 1DP (1 decimal place). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:CTRG_SBP ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{1}$" ;
    sh:severity sh:Warning ;
.

agssh:CTRG-CTRG_SBP-type
