agssh:DPRB-key
    a sh:SPARQLConstraint ;
    sh:message "Another DPRB record has the same combination of KEY fields (LOCA_ID, DPRG_TESN, DPRB_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DPRG_TESN ?v1 .
    $this ags:DPRB_DPTH ?v2 .
    ?xother ags:DPRB_DPTH ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:DPRG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:DPRB }
}""" ;
.

agssh:DPRB-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DPRB record has the same combination of KEY fields (LOCA_ID, DPRG_TESN, DPRB_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DPRG_TESN ?n1 } || NOT EXISTS { $this ags:DPRB_DPTH ?n2 }) }
    ?xother a ags:DPRB .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DPRG_TESN ?a1 } OPTIONAL { ?xother ags:DPRG_TESN ?b1 }
    OPTIONAL { $this ags:DPRB_DPTH ?a2 } OPTIONAL { ?xother ags:DPRB_DPTH ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:DPRB-parent
    a sh:PropertyShape ;
    sh:class ags:DPRG ;
    sh:description "The DPRG (Dynamic Probe Tests - General) record this DPRB record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:DPRB-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching DPRG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:DPRG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

