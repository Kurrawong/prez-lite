agssh:DICT-key
    a sh:SPARQLConstraint ;
    sh:message "Another DICT record has the same combination of KEY fields (DICT_TYPE, DICT_GRP, DICT_HDNG): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:DICT_TYPE ?v0 .
    $this ags:DICT_GRP ?v1 .
    $this ags:DICT_HDNG ?v2 .
    ?xother ags:DICT_TYPE ?v0 .
    ?xother ags:DICT_GRP ?v1 .
    ?xother ags:DICT_HDNG ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:DICT }
}""" ;
.

agssh:DICT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DICT record has the same combination of KEY fields (DICT_TYPE, DICT_GRP, DICT_HDNG): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:DICT_TYPE ?n0 } || NOT EXISTS { $this ags:DICT_GRP ?n1 } || NOT EXISTS { $this ags:DICT_HDNG ?n2 }) }
    ?xother a ags:DICT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:DICT_TYPE ?a0 } OPTIONAL { ?xother ags:DICT_TYPE ?b0 }
    OPTIONAL { $this ags:DICT_GRP ?a1 } OPTIONAL { ?xother ags:DICT_GRP ?b1 }
    OPTIONAL { $this ags:DICT_HDNG ?a2 } OPTIONAL { ?xother ags:DICT_HDNG ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

