agssh:ABBR-key
    a sh:SPARQLConstraint ;
    sh:message "Another ABBR record has the same combination of KEY fields (ABBR_HDNG, ABBR_CODE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:ABBR_HDNG ?v0 .
    $this ags:ABBR_CODE ?v1 .
    ?xother ags:ABBR_HDNG ?v0 .
    ?xother ags:ABBR_CODE ?v1 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:ABBR }
}""" ;
.

agssh:ABBR-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another ABBR record has the same combination of KEY fields (ABBR_HDNG, ABBR_CODE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:ABBR_HDNG ?n0 } || NOT EXISTS { $this ags:ABBR_CODE ?n1 }) }
    ?xother a ags:ABBR .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:ABBR_HDNG ?a0 } OPTIONAL { ?xother ags:ABBR_HDNG ?b0 }
    OPTIONAL { $this ags:ABBR_CODE ?a1 } OPTIONAL { ?xother ags:ABBR_CODE ?b1 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), ""))
}""" ;
.

