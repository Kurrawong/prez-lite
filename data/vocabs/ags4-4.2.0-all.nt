<https://w3id.org/ags4/shapes/SCPT-key-null> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SCPT-key-null> <http://www.w3.org/ns/shacl#message> "Another SCPT record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCPT_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/SCPT-key-null> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SCPT-key-null> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SCPG_TESN ?n1 } || NOT EXISTS { $this ags:SCPT_DPTH ?n2 }) }\n    ?xother a ags:SCPT .\n    FILTER (?xother != $this)\n    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }\n    OPTIONAL { $this ags:SCPG_TESN ?a1 } OPTIONAL { ?xother ags:SCPG_TESN ?b1 }\n    OPTIONAL { $this ags:SCPT_DPTH ?a2 } OPTIONAL { ?xother ags:SCPT_DPTH ?b2 }\n    FILTER (COALESCE(STR(?a0), \"\") = COALESCE(STR(?b0), \"\") && COALESCE(STR(?a1), \"\") = COALESCE(STR(?b1), \"\") && COALESCE(STR(?a2), \"\") = COALESCE(STR(?b2), \"\"))\n}" .
<https://w3id.org/ags4/shapes/SCPT-key> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SCPT-key> <http://www.w3.org/ns/shacl#message> "Another SCPT record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCPT_DPTH): {?xother} (Rule 10a)" .
<https://w3id.org/ags4/shapes/SCPT-key> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SCPT-key> <http://www.w3.org/ns/shacl#select> "SELECT $this ?xother WHERE {\n    $this ags:LOCA_ID ?v0 .\n    $this ags:SCPG_TESN ?v1 .\n    $this ags:SCPT_DPTH ?v2 .\n    ?xother ags:SCPT_DPTH ?v2 .\n    FILTER (?xother != $this)\n    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }\n    FILTER EXISTS { ?xother ags:SCPG_TESN ?v1 }\n    FILTER EXISTS { ?xother a ags:SCPT }\n}" .
<https://w3id.org/ags4/shapes/SCPT-parent-keys> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<https://w3id.org/ags4/shapes/SCPT-parent-keys> <http://www.w3.org/ns/shacl#message> "Key field {?path} = {?value} has no matching SCPG parent record (Rule 10c)" .
<https://w3id.org/ags4/shapes/SCPT-parent-keys> <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/ags4/shapes> .
<https://w3id.org/ags4/shapes/SCPT-parent-keys> <http://www.w3.org/ns/shacl#select> "SELECT $this ?path ?value WHERE {\n    $this ?path ?value .\n    FILTER (?path IN (ags:LOCA_ID, ags:SCPG_TESN))\n    FILTER (STR(?value) != \"\")\n    FILTER NOT EXISTS {\n        $this agso:parent ?parent .\n        ?parent ?path ?parentValue .\n        FILTER (STR(?parentValue) = STR(?value))\n    }\n}" .
<https://w3id.org/ags4/shapes/SCPT-parent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#PropertyShape> .
<https://w3id.org/ags4/shapes/SCPT-parent> <http://www.w3.org/ns/shacl#class> <https://w3id.org/ags4/def/SCPG> .
