    { FILTER (NOT EXISTS { $this ags:LBSG_REF ?n0 }) }
    ?xother a ags:LBSG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LBSG_REF ?a0 } OPTIONAL { ?xother ags:LBSG_REF ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
