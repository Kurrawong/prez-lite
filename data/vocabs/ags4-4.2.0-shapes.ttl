agssh:ELRG-key
    a sh:SPARQLConstraint ;
    sh:message "Another ELRG record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, ELRG_CODE, ELRG_METH, ELRG_MATX, ELRG_RTYP, ELRG_TADE, ELRG_TICN, ELRG_RUNI): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:SAMP_TOP ?v1 .
    $this ags:SAMP_REF ?v2 .
    $this ags:SAMP_TYPE ?v3 .
    $this ags:SAMP_ID ?v4 .
    $this ags:SPEC_REF ?v5 .
    $this ags:SPEC_DPTH ?v6 .
    $this ags:ELRG_CODE ?v7 .
    $this ags:ELRG_METH ?v8 .
    $this ags:ELRG_MATX ?v9 .
    $this ags:ELRG_RTYP ?v10 .
    $this ags:ELRG_TADE ?v11 .
    $this ags:ELRG_TICN ?v12 .
    $this ags:ELRG_RUNI ?v13 .
    ?xother ags:ELRG_CODE ?v7 .
    ?xother ags:ELRG_METH ?v8 .
    ?xother ags:ELRG_MATX ?v9 .
    ?xother ags:ELRG_RTYP ?v10 .
    ?xother ags:ELRG_TADE ?v11 .
    ?xother ags:ELRG_TICN ?v12 .
    ?xother ags:ELRG_RUNI ?v13 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:SAMP_TOP ?v1 }
    FILTER EXISTS { ?xother ags:SAMP_REF ?v2 }
    FILTER EXISTS { ?xother ags:SAMP_TYPE ?v3 }
    FILTER EXISTS { ?xother ags:SAMP_ID ?v4 }
    FILTER EXISTS { ?xother ags:SPEC_REF ?v5 }
    FILTER EXISTS { ?xother ags:SPEC_DPTH ?v6 }
    FILTER EXISTS { ?xother a ags:ELRG }
}""" ;
.

agssh:ELRG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another ELRG record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, ELRG_CODE, ELRG_METH, ELRG_MATX, ELRG_RTYP, ELRG_TADE, ELRG_TICN, ELRG_RUNI): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:SPEC_REF ?n5 } || NOT EXISTS { $this ags:SPEC_DPTH ?n6 } || NOT EXISTS { $this ags:ELRG_CODE ?n7 } || NOT EXISTS { $this ags:ELRG_METH ?n8 } || NOT EXISTS { $this ags:ELRG_MATX ?n9 } || NOT EXISTS { $this ags:ELRG_RTYP ?n10 } || NOT EXISTS { $this ags:ELRG_TADE ?n11 } || NOT EXISTS { $this ags:ELRG_TICN ?n12 } || NOT EXISTS { $this ags:ELRG_RUNI ?n13 }) }
    ?xother a ags:ELRG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }
    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }
    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }
    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }
    OPTIONAL { $this ags:SPEC_REF ?a5 } OPTIONAL { ?xother ags:SPEC_REF ?b5 }
    OPTIONAL { $this ags:SPEC_DPTH ?a6 } OPTIONAL { ?xother ags:SPEC_DPTH ?b6 }
    OPTIONAL { $this ags:ELRG_CODE ?a7 } OPTIONAL { ?xother ags:ELRG_CODE ?b7 }
    OPTIONAL { $this ags:ELRG_METH ?a8 } OPTIONAL { ?xother ags:ELRG_METH ?b8 }
    OPTIONAL { $this ags:ELRG_MATX ?a9 } OPTIONAL { ?xother ags:ELRG_MATX ?b9 }
    OPTIONAL { $this ags:ELRG_RTYP ?a10 } OPTIONAL { ?xother ags:ELRG_RTYP ?b10 }
    OPTIONAL { $this ags:ELRG_TADE ?a11 } OPTIONAL { ?xother ags:ELRG_TADE ?b11 }
    OPTIONAL { $this ags:ELRG_TICN ?a12 } OPTIONAL { ?xother ags:ELRG_TICN ?b12 }
    OPTIONAL { $this ags:ELRG_RUNI ?a13 } OPTIONAL { ?xother ags:ELRG_RUNI ?b13 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), "") && COALESCE(STR(?a5), "") = COALESCE(STR(?b5), "") && COALESCE(STR(?a6), "") = COALESCE(STR(?b6), "") && COALESCE(STR(?a7), "") = COALESCE(STR(?b7), "") && COALESCE(STR(?a8), "") = COALESCE(STR(?b8), "") && COALESCE(STR(?a9), "") = COALESCE(STR(?b9), "") && COALESCE(STR(?a10), "") = COALESCE(STR(?b10), "") && COALESCE(STR(?a11), "") = COALESCE(STR(?b11), "") && COALESCE(STR(?a12), "") = COALESCE(STR(?b12), "") && COALESCE(STR(?a13), "") = COALESCE(STR(?b13), ""))
}""" ;
.

agssh:ELRG-parent
    a sh:PropertyShape ;
    sh:class ags:SAMP ;
    sh:description "The SAMP (Sample Information) record this ELRG record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:ELRG-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching SAMP parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:SAMP_TOP, ags:SAMP_REF, ags:SAMP_TYPE, ags:SAMP_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

