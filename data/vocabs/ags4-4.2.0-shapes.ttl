agssh:CDIA-key
    a sh:SPARQLConstraint ;
    sh:message "Another CDIA record has the same combination of KEY fields (LOCA_ID, CDIA_DPTH, CDIA_DIAM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:CDIA_DPTH ?v1 .
    $this ags:CDIA_DIAM ?v2 .
    ?xother ags:CDIA_DPTH ?v1 .
    ?xother ags:CDIA_DIAM ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:CDIA }
}""" ;
.

