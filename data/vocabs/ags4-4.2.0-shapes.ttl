agssh:DOBS-key
    a sh:SPARQLConstraint ;
    sh:message "Another DOBS record has the same combination of KEY fields (LOCA_ID, DOBS_TOP, DOBS_BASE, DOBS_SET): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DOBS_TOP ?v1 .
    $this ags:DOBS_BASE ?v2 .
    $this ags:DOBS_SET ?v3 .
    ?xother ags:DOBS_TOP ?v1 .
    ?xother ags:DOBS_BASE ?v2 .
    ?xother ags:DOBS_SET ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:DOBS }
}""" ;
.

agssh:DOBS-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DOBS record has the same combination of KEY fields (LOCA_ID, DOBS_TOP, DOBS_BASE, DOBS_SET): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DOBS_TOP ?n1 } || NOT EXISTS { $this ags:DOBS_BASE ?n2 } || NOT EXISTS { $this ags:DOBS_SET ?n3 }) }
    ?xother a ags:DOBS .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DOBS_TOP ?a1 } OPTIONAL { ?xother ags:DOBS_TOP ?b1 }
    OPTIONAL { $this ags:DOBS_BASE ?a2 } OPTIONAL { ?xother ags:DOBS_BASE ?b2 }
    OPTIONAL { $this ags:DOBS_SET ?a3 } OPTIONAL { ?xother ags:DOBS_SET ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:DOBS-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this DOBS record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:DOBS-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

