    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:CDIA_DPTH ?n1 } || NOT EXISTS { $this ags:CDIA_DIAM ?n2 }) }
    ?xother a ags:CDIA .
