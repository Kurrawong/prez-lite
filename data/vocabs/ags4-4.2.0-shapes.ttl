agssh:TRAN-key
    a sh:SPARQLConstraint ;
    sh:message "Another TRAN record has the same combination of KEY fields (TRAN_ISNO): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:TRAN_ISNO ?v0 .
    ?xother ags:TRAN_ISNO ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:TRAN }
}""" ;
.

agssh:TRAN-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another TRAN record has the same combination of KEY fields (TRAN_ISNO): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:TRAN_ISNO ?n0 }) }
    ?xother a ags:TRAN .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:TRAN_ISNO ?a0 } OPTIONAL { ?xother ags:TRAN_ISNO ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
.

agssh:TRAN-single-row
    a sh:SPARQLConstraint ;
    sh:message "A data file shall contain only one TRAN data row (Rule 14)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?other WHERE {
    ?other a ags:TRAN .
    FILTER (?other != $this)
}""" ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-14> ;
.

