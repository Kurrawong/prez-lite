    sh:message "Another SCPP record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCPP_TOP, SCPP_BASE, SCPP_REF): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:SCPG_TESN ?v1 .
    $this ags:SCPP_TOP ?v2 .
    $this ags:SCPP_BASE ?v3 .
    $this ags:SCPP_REF ?v4 .
    ?xother ags:SCPP_TOP ?v2 .
    ?xother ags:SCPP_BASE ?v3 .
    ?xother ags:SCPP_REF ?v4 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:SCPG_TESN ?v1 }
    FILTER EXISTS { ?xother a ags:SCPP }
}""" ;
.

agssh:SCPP-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another SCPP record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCPP_TOP, SCPP_BASE, SCPP_REF): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SCPG_TESN ?n1 } || NOT EXISTS { $this ags:SCPP_TOP ?n2 } || NOT EXISTS { $this ags:SCPP_BASE ?n3 } || NOT EXISTS { $this ags:SCPP_REF ?n4 }) }
    ?xother a ags:SCPP .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:SCPG_TESN ?a1 } OPTIONAL { ?xother ags:SCPG_TESN ?b1 }
    OPTIONAL { $this ags:SCPP_TOP ?a2 } OPTIONAL { ?xother ags:SCPP_TOP ?b2 }
    OPTIONAL { $this ags:SCPP_BASE ?a3 } OPTIONAL { ?xother ags:SCPP_BASE ?b3 }
    OPTIONAL { $this ags:SCPP_REF ?a4 } OPTIONAL { ?xother ags:SCPP_REF ?b4 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), ""))
}""" ;
.

agssh:SCPP-parent
    a sh:PropertyShape ;
    sh:class ags:SCPG ;
    sh:description "The SCPG (Static Cone Penetration Tests - General) record this SCPP record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:SCPP-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching SCPG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:SCPG_TESN))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

