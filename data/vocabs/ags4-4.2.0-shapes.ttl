agssh:HDPH-key
    a sh:SPARQLConstraint ;
    sh:message "Another HDPH record has the same combination of KEY fields (LOCA_ID, HDPH_TOP, HDPH_BASE, HDPH_TYPE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:HDPH_TOP ?v1 .
    $this ags:HDPH_BASE ?v2 .
    $this ags:HDPH_TYPE ?v3 .
    ?xother ags:HDPH_TOP ?v1 .
    ?xother ags:HDPH_BASE ?v2 .
    ?xother ags:HDPH_TYPE ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:HDPH }
}""" ;
.

agssh:HDPH-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another HDPH record has the same combination of KEY fields (LOCA_ID, HDPH_TOP, HDPH_BASE, HDPH_TYPE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:HDPH_TOP ?n1 } || NOT EXISTS { $this ags:HDPH_BASE ?n2 } || NOT EXISTS { $this ags:HDPH_TYPE ?n3 }) }
    ?xother a ags:HDPH .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:HDPH_TOP ?a1 } OPTIONAL { ?xother ags:HDPH_TOP ?b1 }
    OPTIONAL { $this ags:HDPH_BASE ?a2 } OPTIONAL { ?xother ags:HDPH_BASE ?b2 }
    OPTIONAL { $this ags:HDPH_TYPE ?a3 } OPTIONAL { ?xother ags:HDPH_TYPE ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:HDPH-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this HDPH record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:HDPH-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

