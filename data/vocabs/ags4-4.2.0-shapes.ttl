agssh:ElapsedTimeValue
    a sh:NodeShape ;
    rdfs:isDefinedBy <https://w3id.org/ags4/shapes> ;
    sh:description "A literal of one of the datatypes xsd:duration, xsd:time, xsd:string."@en ;
    sh:name "ElapsedTimeValue" ;
    sh:nodeKind sh:Literal ;
    sh:or (
        
        [
            sh:datatype xsd:duration ;
        ]
        
        [
            sh:datatype xsd:time ;
        ]
        
        [
            sh:datatype xsd:string ;
        ]
    ) ;
.

agssh:YesNoValue
