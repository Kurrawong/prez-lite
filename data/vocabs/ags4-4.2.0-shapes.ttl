agssh:CPDT-key
    a sh:SPARQLConstraint ;
    sh:message "Another CPDT record has the same combination of KEY fields (LOCA_ID, CPTG_TESN, CPDG_DPTH, CPDT_TIME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:CPTG_TESN ?v1 .
    $this ags:CPDG_DPTH ?v2 .
    $this ags:CPDT_TIME ?v3 .
    ?xother ags:CPDT_TIME ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:CPTG_TESN ?v1 }
    FILTER EXISTS { ?xother ags:CPDG_DPTH ?v2 }
    FILTER EXISTS { ?xother a ags:CPDT }
}""" ;
.

agssh:CPDT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another CPDT record has the same combination of KEY fields (LOCA_ID, CPTG_TESN, CPDG_DPTH, CPDT_TIME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:CPTG_TESN ?n1 } || NOT EXISTS { $this ags:CPDG_DPTH ?n2 } || NOT EXISTS { $this ags:CPDT_TIME ?n3 }) }
    ?xother a ags:CPDT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:CPTG_TESN ?a1 } OPTIONAL { ?xother ags:CPTG_TESN ?b1 }
    OPTIONAL { $this ags:CPDG_DPTH ?a2 } OPTIONAL { ?xother ags:CPDG_DPTH ?b2 }
    OPTIONAL { $this ags:CPDT_TIME ?a3 } OPTIONAL { ?xother ags:CPDT_TIME ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:CPDT-parent
    a sh:PropertyShape ;
    sh:class ags:CPDG ;
    sh:description "The CPDG (Pore Pressure Dissipation Tests (PPDT) - General) record this CPDT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:CPDT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching CPDG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:CPTG_TESN, ags:CPDG_DPTH))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

