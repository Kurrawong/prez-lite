agssh:DISC-key
    a sh:SPARQLConstraint ;
    sh:message "Another DISC record has the same combination of KEY fields (LOCA_ID, DISC_TOP, DISC_BASE, FRAC_SET, DISC_NUMB): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DISC_TOP ?v1 .
    $this ags:DISC_BASE ?v2 .
    $this ags:FRAC_SET ?v3 .
    $this ags:DISC_NUMB ?v4 .
    ?xother ags:DISC_TOP ?v1 .
    ?xother ags:DISC_BASE ?v2 .
    ?xother ags:DISC_NUMB ?v4 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:FRAC_SET ?v3 }
    FILTER EXISTS { ?xother a ags:DISC }
}""" ;
.

agssh:DISC-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DISC record has the same combination of KEY fields (LOCA_ID, DISC_TOP, DISC_BASE, FRAC_SET, DISC_NUMB): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DISC_TOP ?n1 } || NOT EXISTS { $this ags:DISC_BASE ?n2 } || NOT EXISTS { $this ags:FRAC_SET ?n3 } || NOT EXISTS { $this ags:DISC_NUMB ?n4 }) }
    ?xother a ags:DISC .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DISC_TOP ?a1 } OPTIONAL { ?xother ags:DISC_TOP ?b1 }
    OPTIONAL { $this ags:DISC_BASE ?a2 } OPTIONAL { ?xother ags:DISC_BASE ?b2 }
    OPTIONAL { $this ags:FRAC_SET ?a3 } OPTIONAL { ?xother ags:FRAC_SET ?b3 }
    OPTIONAL { $this ags:DISC_NUMB ?a4 } OPTIONAL { ?xother ags:DISC_NUMB ?b4 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), ""))
}""" ;
.

agssh:DISC-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this DISC record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:DISC-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

