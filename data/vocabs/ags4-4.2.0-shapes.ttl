agssh:MONS-key
    a sh:SPARQLConstraint ;
    sh:message "Another MONS record has the same combination of KEY fields (LOCA_ID, MONG_ID, MONG_DIS, MONS_STAR): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:MONG_ID ?v1 .
    $this ags:MONG_DIS ?v2 .
    $this ags:MONS_STAR ?v3 .
    ?xother ags:MONS_STAR ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:MONG_ID ?v1 }
    FILTER EXISTS { ?xother ags:MONG_DIS ?v2 }
    FILTER EXISTS { ?xother a ags:MONS }
}""" ;
.

agssh:MONS-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another MONS record has the same combination of KEY fields (LOCA_ID, MONG_ID, MONG_DIS, MONS_STAR): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:MONG_ID ?n1 } || NOT EXISTS { $this ags:MONG_DIS ?n2 } || NOT EXISTS { $this ags:MONS_STAR ?n3 }) }
    ?xother a ags:MONS .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:MONG_ID ?a1 } OPTIONAL { ?xother ags:MONG_ID ?b1 }
    OPTIONAL { $this ags:MONG_DIS ?a2 } OPTIONAL { ?xother ags:MONG_DIS ?b2 }
    OPTIONAL { $this ags:MONS_STAR ?a3 } OPTIONAL { ?xother ags:MONS_STAR ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:MONS-parent
    a sh:PropertyShape ;
    sh:class ags:MONG ;
    sh:description "The MONG (Monitoring Installations and Instruments) record this MONS record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:MONS-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching MONG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:MONG_ID, ags:MONG_DIS))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

