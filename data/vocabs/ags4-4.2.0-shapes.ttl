agssh:DCPG-key
    a sh:SPARQLConstraint ;
    sh:message "Another DCPG record has the same combination of KEY fields (LOCA_ID, DCPG_DATE, DCPG_TESN, DCPG_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DCPG_DATE ?v1 .
    $this ags:DCPG_TESN ?v2 .
    $this ags:DCPG_DPTH ?v3 .
    ?xother ags:DCPG_DATE ?v1 .
    ?xother ags:DCPG_TESN ?v2 .
    ?xother ags:DCPG_DPTH ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:DCPG }
}""" ;
.

agssh:DCPG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DCPG record has the same combination of KEY fields (LOCA_ID, DCPG_DATE, DCPG_TESN, DCPG_DPTH): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DCPG_DATE ?n1 } || NOT EXISTS { $this ags:DCPG_TESN ?n2 } || NOT EXISTS { $this ags:DCPG_DPTH ?n3 }) }
    ?xother a ags:DCPG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DCPG_DATE ?a1 } OPTIONAL { ?xother ags:DCPG_DATE ?b1 }
    OPTIONAL { $this ags:DCPG_TESN ?a2 } OPTIONAL { ?xother ags:DCPG_TESN ?b2 }
    OPTIONAL { $this ags:DCPG_DPTH ?a3 } OPTIONAL { ?xother ags:DCPG_DPTH ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:DCPG-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this DCPG record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:DCPG-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

