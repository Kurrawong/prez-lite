    sh:path ags:LOCA_ID ;
    agso:dataType <https://w3id.org/ags4/voc/data-types/ID> ;
    agso:dictionaryEntry <https://w3id.org/ags4/voc/dictionary/LOCA_ID> ;
    agso:headingStatus "*" ;
    agso:isKey true ;
    agso:isRequired false ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10a> ;
.

