    agso:suggestedUnit <https://w3id.org/ags4/voc/units/m> ;
.

agssh:RCAT-SPEC_DPTH-format
    a sh:PropertyShape ;
    sh:message "SPEC_DPTH: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:SPEC_DPTH ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

agssh:RCAT-SPEC_DPTH-type
