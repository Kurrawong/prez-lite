agssh:LOCA-key
    a sh:SPARQLConstraint ;
    sh:message "Another LOCA record has the same combination of KEY fields (LOCA_ID): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    ?xother ags:LOCA_ID ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:LOCA }
}""" ;
.

agssh:LOCA-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another LOCA record has the same combination of KEY fields (LOCA_ID): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 }) }
    ?xother a ags:LOCA .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
.

