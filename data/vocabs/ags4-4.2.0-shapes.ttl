agssh:LBST-key
    a sh:SPARQLConstraint ;
    sh:message "Another LBST record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, LBSG_REF, LBST_TEST): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:SAMP_TOP ?v1 .
    $this ags:SAMP_REF ?v2 .
    $this ags:SAMP_TYPE ?v3 .
    $this ags:SAMP_ID ?v4 .
    $this ags:LBSG_REF ?v5 .
    $this ags:LBST_TEST ?v6 .
    ?xother ags:LBST_TEST ?v6 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:SAMP_TOP ?v1 }
    FILTER EXISTS { ?xother ags:SAMP_REF ?v2 }
    FILTER EXISTS { ?xother ags:SAMP_TYPE ?v3 }
    FILTER EXISTS { ?xother ags:SAMP_ID ?v4 }
    FILTER EXISTS { ?xother ags:LBSG_REF ?v5 }
    FILTER EXISTS { ?xother a ags:LBST }
}""" ;
.

agssh:LBST-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another LBST record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, LBSG_REF, LBST_TEST): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:LBSG_REF ?n5 } || NOT EXISTS { $this ags:LBST_TEST ?n6 }) }
    ?xother a ags:LBST .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }
    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }
    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }
    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }
    OPTIONAL { $this ags:LBSG_REF ?a5 } OPTIONAL { ?xother ags:LBSG_REF ?b5 }
    OPTIONAL { $this ags:LBST_TEST ?a6 } OPTIONAL { ?xother ags:LBST_TEST ?b6 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), "") && COALESCE(STR(?a5), "") = COALESCE(STR(?b5), "") && COALESCE(STR(?a6), "") = COALESCE(STR(?b6), ""))
}""" ;
.

agssh:LBST-parent
    a sh:PropertyShape ;
    sh:class ags:LBSG ;
    sh:description "The LBSG (Testing Schedule) record this LBST record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:LBST-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LBSG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LBSG_REF))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

