agssh:PREM-key
    a sh:SPARQLConstraint ;
    sh:message "Another PREM record has the same combination of KEY fields (PREM_DTIM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:PREM_DTIM ?v0 .
    ?xother ags:PREM_DTIM ?v0 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:PREM }
}""" ;
.

agssh:PREM-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PREM record has the same combination of KEY fields (PREM_DTIM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:PREM_DTIM ?n0 }) }
    ?xother a ags:PREM .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:PREM_DTIM ?a0 } OPTIONAL { ?xother ags:PREM_DTIM ?b0 }
