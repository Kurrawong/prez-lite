.

agssh:GEOL-LOCA_ID-type
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "LOCA_ID: value is not of the suggested type ID (text). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
