    a sh:SPARQLConstraint ;
    sh:message "Another DLOG record has the same combination of KEY fields (LOCA_ID, DLOG_TOP, DLOG_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:DLOG_TOP ?v1 .
    $this ags:DLOG_BASE ?v2 .
    ?xother ags:DLOG_TOP ?v1 .
    ?xother ags:DLOG_BASE ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:DLOG }
}""" ;
.

agssh:DLOG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another DLOG record has the same combination of KEY fields (LOCA_ID, DLOG_TOP, DLOG_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:DLOG_TOP ?n1 } || NOT EXISTS { $this ags:DLOG_BASE ?n2 }) }
    ?xother a ags:DLOG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:DLOG_TOP ?a1 } OPTIONAL { ?xother ags:DLOG_TOP ?b1 }
    OPTIONAL { $this ags:DLOG_BASE ?a2 } OPTIONAL { ?xother ags:DLOG_BASE ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:DLOG-parent
    a sh:PropertyShape ;
