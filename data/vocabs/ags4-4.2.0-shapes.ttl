agssh:LDEN-LDEN_BDEN-format
    a sh:PropertyShape ;
    sh:message "LDEN_BDEN: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:LDEN_BDEN ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

agssh:LDEN-LDEN_BDEN-type
    a sh:PropertyShape ;
    sh:message "LDEN_BDEN: value is not of the suggested type 2DP (a number). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:node agssh:NumericValue ;
    sh:path ags:LDEN_BDEN ;
    sh:severity sh:Warning ;
.

