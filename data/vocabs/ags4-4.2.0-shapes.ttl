agssh:PMMG-key
    a sh:SPARQLConstraint ;
    sh:message "Another PMMG record has the same combination of KEY fields (LOCA_ID, PMMG_DPTH, PMMG_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PMMG_DPTH ?v1 .
    $this ags:PMMG_TESN ?v2 .
    ?xother ags:PMMG_DPTH ?v1 .
    ?xother ags:PMMG_TESN ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:PMMG }
}""" ;
.

agssh:PMMG-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PMMG record has the same combination of KEY fields (LOCA_ID, PMMG_DPTH, PMMG_TESN): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PMMG_DPTH ?n1 } || NOT EXISTS { $this ags:PMMG_TESN ?n2 }) }
    ?xother a ags:PMMG .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PMMG_DPTH ?a1 } OPTIONAL { ?xother ags:PMMG_DPTH ?b1 }
    OPTIONAL { $this ags:PMMG_TESN ?a2 } OPTIONAL { ?xother ags:PMMG_TESN ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

