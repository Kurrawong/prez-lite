agssh:GCHM-key
    a sh:SPARQLConstraint ;
    sh:message "Another GCHM record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, GCHM_CODE, GCHM_METH, GCHM_TTYP): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:SAMP_TOP ?v1 .
    $this ags:SAMP_REF ?v2 .
    $this ags:SAMP_TYPE ?v3 .
    $this ags:SAMP_ID ?v4 .
    $this ags:SPEC_REF ?v5 .
    $this ags:SPEC_DPTH ?v6 .
    $this ags:GCHM_CODE ?v7 .
    $this ags:GCHM_METH ?v8 .
    $this ags:GCHM_TTYP ?v9 .
    ?xother ags:GCHM_CODE ?v7 .
    ?xother ags:GCHM_METH ?v8 .
    ?xother ags:GCHM_TTYP ?v9 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:SAMP_TOP ?v1 }
    FILTER EXISTS { ?xother ags:SAMP_REF ?v2 }
    FILTER EXISTS { ?xother ags:SAMP_TYPE ?v3 }
    FILTER EXISTS { ?xother ags:SAMP_ID ?v4 }
    FILTER EXISTS { ?xother ags:SPEC_REF ?v5 }
    FILTER EXISTS { ?xother ags:SPEC_DPTH ?v6 }
    FILTER EXISTS { ?xother a ags:GCHM }
}""" ;
.

agssh:GCHM-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another GCHM record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, GCHM_CODE, GCHM_METH, GCHM_TTYP): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:SPEC_REF ?n5 } || NOT EXISTS { $this ags:SPEC_DPTH ?n6 } || NOT EXISTS { $this ags:GCHM_CODE ?n7 } || NOT EXISTS { $this ags:GCHM_METH ?n8 } || NOT EXISTS { $this ags:GCHM_TTYP ?n9 }) }
    ?xother a ags:GCHM .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }
    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }
    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }
    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }
    OPTIONAL { $this ags:SPEC_REF ?a5 } OPTIONAL { ?xother ags:SPEC_REF ?b5 }
    OPTIONAL { $this ags:SPEC_DPTH ?a6 } OPTIONAL { ?xother ags:SPEC_DPTH ?b6 }
    OPTIONAL { $this ags:GCHM_CODE ?a7 } OPTIONAL { ?xother ags:GCHM_CODE ?b7 }
    OPTIONAL { $this ags:GCHM_METH ?a8 } OPTIONAL { ?xother ags:GCHM_METH ?b8 }
    OPTIONAL { $this ags:GCHM_TTYP ?a9 } OPTIONAL { ?xother ags:GCHM_TTYP ?b9 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), "") && COALESCE(STR(?a5), "") = COALESCE(STR(?b5), "") && COALESCE(STR(?a6), "") = COALESCE(STR(?b6), "") && COALESCE(STR(?a7), "") = COALESCE(STR(?b7), "") && COALESCE(STR(?a8), "") = COALESCE(STR(?b8), "") && COALESCE(STR(?a9), "") = COALESCE(STR(?b9), ""))
}""" ;
.

agssh:GCHM-parent
    a sh:PropertyShape ;
    sh:class ags:SAMP ;
    sh:description "The SAMP (Sample Information) record this GCHM record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:GCHM-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching SAMP parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:SAMP_TOP, ags:SAMP_REF, ags:SAMP_TYPE, ags:SAMP_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

