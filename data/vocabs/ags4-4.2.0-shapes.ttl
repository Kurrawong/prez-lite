    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:UNIT_UNIT ?n0 }) }
    ?xother a ags:UNIT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:UNIT_UNIT ?a0 } OPTIONAL { ?xother ags:UNIT_UNIT ?b0 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), ""))
}""" ;
