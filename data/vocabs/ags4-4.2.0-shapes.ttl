    sh:message "ISTA_UPSR: value is not in the suggested format 3DP (3 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:ISTA_UPSR ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{3}$" ;
    sh:severity sh:Warning ;
.

agssh:ISTA-ISTA_UPSR-type
