    a sh:PropertyShape ;
    sh:message "SHBT_DIA1: value is not in the suggested format 2DP (2 decimal places). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:path ags:SHBT_DIA1 ;
    sh:pattern "^[+-]?[0-9]+\\.[0-9]{2}$" ;
    sh:severity sh:Warning ;
.

agssh:SHBT-SHBT_DIA1-type
    a sh:PropertyShape ;
    sh:message "SHBT_DIA1: value is not of the suggested type 2DP (a number). This is allowed if the file's TYPE row declares another type (Rule 8)." ;
    sh:node agssh:NumericValue ;
    sh:path ags:SHBT_DIA1 ;
    sh:severity sh:Warning ;
.

