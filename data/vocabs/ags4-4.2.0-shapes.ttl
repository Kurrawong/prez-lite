agssh:SCDT-key
    a sh:SPARQLConstraint ;
    sh:message "Another SCDT record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCDG_DPTH, SCDT_SECS): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:SCPG_TESN ?v1 .
    $this ags:SCDG_DPTH ?v2 .
    $this ags:SCDT_SECS ?v3 .
    ?xother ags:SCDT_SECS ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother ags:SCPG_TESN ?v1 }
    FILTER EXISTS { ?xother ags:SCDG_DPTH ?v2 }
    FILTER EXISTS { ?xother a ags:SCDT }
}""" ;
.

agssh:SCDT-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another SCDT record has the same combination of KEY fields (LOCA_ID, SCPG_TESN, SCDG_DPTH, SCDT_SECS): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SCPG_TESN ?n1 } || NOT EXISTS { $this ags:SCDG_DPTH ?n2 } || NOT EXISTS { $this ags:SCDT_SECS ?n3 }) }
    ?xother a ags:SCDT .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:SCPG_TESN ?a1 } OPTIONAL { ?xother ags:SCPG_TESN ?b1 }
    OPTIONAL { $this ags:SCDG_DPTH ?a2 } OPTIONAL { ?xother ags:SCDG_DPTH ?b2 }
    OPTIONAL { $this ags:SCDT_SECS ?a3 } OPTIONAL { ?xother ags:SCDT_SECS ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

agssh:SCDT-parent
    a sh:PropertyShape ;
    sh:class ags:SCDG ;
    sh:description "The SCDG (Static Cone Dissipation Tests - General) record this SCDT record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:SCDT-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching SCDG parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:SCPG_TESN, ags:SCDG_DPTH))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

