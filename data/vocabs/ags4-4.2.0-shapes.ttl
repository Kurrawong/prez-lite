agssh:FILE-key
    a sh:SPARQLConstraint ;
    sh:message "Another FILE record has the same combination of KEY fields (FILE_FSET, FILE_NAME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:FILE_FSET ?v0 .
    $this ags:FILE_NAME ?v1 .
    ?xother ags:FILE_FSET ?v0 .
    ?xother ags:FILE_NAME ?v1 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:FILE }
}""" ;
.

agssh:FILE-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another FILE record has the same combination of KEY fields (FILE_FSET, FILE_NAME): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:FILE_FSET ?n0 } || NOT EXISTS { $this ags:FILE_NAME ?n1 }) }
    ?xother a ags:FILE .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:FILE_FSET ?a0 } OPTIONAL { ?xother ags:FILE_FSET ?b0 }
    OPTIONAL { $this ags:FILE_NAME ?a1 } OPTIONAL { ?xother ags:FILE_NAME ?b1 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), ""))
}""" ;
.

