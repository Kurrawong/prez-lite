agssh:CTRD-key
    a sh:SPARQLConstraint ;
    sh:message "Another CTRD record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, CTRC_TESN, CTRP_CYC): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:SAMP_TOP ?v1 .
    $this ags:SAMP_REF ?v2 .
    $this ags:SAMP_TYPE ?v3 .
    $this ags:SAMP_ID ?v4 .
    $this ags:SPEC_REF ?v5 .
    $this ags:SPEC_DPTH ?v6 .
    $this ags:CTRC_TESN ?v7 .
    $this ags:CTRP_CYC ?v8 .
    ?xother ags:LOCA_ID ?v0 .
    ?xother ags:SAMP_TOP ?v1 .
    ?xother ags:SAMP_REF ?v2 .
    ?xother ags:SAMP_TYPE ?v3 .
    ?xother ags:SAMP_ID ?v4 .
    ?xother ags:SPEC_REF ?v5 .
    ?xother ags:SPEC_DPTH ?v6 .
    ?xother ags:CTRC_TESN ?v7 .
    ?xother ags:CTRP_CYC ?v8 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother a ags:CTRD }
}""" ;
.

agssh:CTRD-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another CTRD record has the same combination of KEY fields (LOCA_ID, SAMP_TOP, SAMP_REF, SAMP_TYPE, SAMP_ID, SPEC_REF, SPEC_DPTH, CTRC_TESN, CTRP_CYC): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:SAMP_TOP ?n1 } || NOT EXISTS { $this ags:SAMP_REF ?n2 } || NOT EXISTS { $this ags:SAMP_TYPE ?n3 } || NOT EXISTS { $this ags:SAMP_ID ?n4 } || NOT EXISTS { $this ags:SPEC_REF ?n5 } || NOT EXISTS { $this ags:SPEC_DPTH ?n6 } || NOT EXISTS { $this ags:CTRC_TESN ?n7 } || NOT EXISTS { $this ags:CTRP_CYC ?n8 }) }
    ?xother a ags:CTRD .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:SAMP_TOP ?a1 } OPTIONAL { ?xother ags:SAMP_TOP ?b1 }
    OPTIONAL { $this ags:SAMP_REF ?a2 } OPTIONAL { ?xother ags:SAMP_REF ?b2 }
    OPTIONAL { $this ags:SAMP_TYPE ?a3 } OPTIONAL { ?xother ags:SAMP_TYPE ?b3 }
    OPTIONAL { $this ags:SAMP_ID ?a4 } OPTIONAL { ?xother ags:SAMP_ID ?b4 }
    OPTIONAL { $this ags:SPEC_REF ?a5 } OPTIONAL { ?xother ags:SPEC_REF ?b5 }
    OPTIONAL { $this ags:SPEC_DPTH ?a6 } OPTIONAL { ?xother ags:SPEC_DPTH ?b6 }
    OPTIONAL { $this ags:CTRC_TESN ?a7 } OPTIONAL { ?xother ags:CTRC_TESN ?b7 }
    OPTIONAL { $this ags:CTRP_CYC ?a8 } OPTIONAL { ?xother ags:CTRP_CYC ?b8 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), "") && COALESCE(STR(?a4), "") = COALESCE(STR(?b4), "") && COALESCE(STR(?a5), "") = COALESCE(STR(?b5), "") && COALESCE(STR(?a6), "") = COALESCE(STR(?b6), "") && COALESCE(STR(?a7), "") = COALESCE(STR(?b7), "") && COALESCE(STR(?a8), "") = COALESCE(STR(?b8), ""))
}""" ;
.

agssh:CTRD-parent
    a sh:PropertyShape ;
    sh:class ags:CTRP ;
    sh:description "The CTRP (Cyclic Triaxial Test - Derived Parameters) record this CTRD record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:CTRD-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching CTRP parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID, ags:SAMP_TOP, ags:SAMP_REF, ags:SAMP_TYPE, ags:SAMP_ID, ags:SPEC_REF, ags:SPEC_DPTH, ags:CTRC_TESN, ags:CTRP_CYC))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

