    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:CDIA_DPTH ?a1 } OPTIONAL { ?xother ags:CDIA_DPTH ?b1 }
    OPTIONAL { $this ags:CDIA_DIAM ?a2 } OPTIONAL { ?xother ags:CDIA_DIAM ?b2 }
