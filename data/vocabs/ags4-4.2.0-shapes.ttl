agssh:PIPE-key
    a sh:SPARQLConstraint ;
    sh:message "Another PIPE record has the same combination of KEY fields (LOCA_ID, PIPE_REF, PIPE_TOP, PIPE_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:PIPE_REF ?v1 .
    $this ags:PIPE_TOP ?v2 .
    $this ags:PIPE_BASE ?v3 .
    ?xother ags:PIPE_REF ?v1 .
    ?xother ags:PIPE_TOP ?v2 .
    ?xother ags:PIPE_BASE ?v3 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:PIPE }
}""" ;
.

agssh:PIPE-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another PIPE record has the same combination of KEY fields (LOCA_ID, PIPE_REF, PIPE_TOP, PIPE_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:PIPE_REF ?n1 } || NOT EXISTS { $this ags:PIPE_TOP ?n2 } || NOT EXISTS { $this ags:PIPE_BASE ?n3 }) }
    ?xother a ags:PIPE .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:PIPE_REF ?a1 } OPTIONAL { ?xother ags:PIPE_REF ?b1 }
    OPTIONAL { $this ags:PIPE_TOP ?a2 } OPTIONAL { ?xother ags:PIPE_TOP ?b2 }
    OPTIONAL { $this ags:PIPE_BASE ?a3 } OPTIONAL { ?xother ags:PIPE_BASE ?b3 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), "") && COALESCE(STR(?a3), "") = COALESCE(STR(?b3), ""))
}""" ;
.

