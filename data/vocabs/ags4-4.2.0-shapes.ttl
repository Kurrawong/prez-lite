    a sh:SPARQLConstraint ;
    sh:message "Another HDIA record has the same combination of KEY fields (LOCA_ID, HDIA_DPTH, HDIA_DIAM): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:HDIA_DPTH ?n1 } || NOT EXISTS { $this ags:HDIA_DIAM ?n2 }) }
    ?xother a ags:HDIA .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:HDIA_DPTH ?a1 } OPTIONAL { ?xother ags:HDIA_DPTH ?b1 }
    OPTIONAL { $this ags:HDIA_DIAM ?a2 } OPTIONAL { ?xother ags:HDIA_DIAM ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

