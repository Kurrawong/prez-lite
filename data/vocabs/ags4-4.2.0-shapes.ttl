agssh:WADD-key
    a sh:SPARQLConstraint ;
    sh:message "Another WADD record has the same combination of KEY fields (LOCA_ID, WADD_TOP, WADD_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    $this ags:LOCA_ID ?v0 .
    $this ags:WADD_TOP ?v1 .
    $this ags:WADD_BASE ?v2 .
    ?xother ags:WADD_TOP ?v1 .
    ?xother ags:WADD_BASE ?v2 .
    FILTER (?xother != $this)
    FILTER EXISTS { ?xother ags:LOCA_ID ?v0 }
    FILTER EXISTS { ?xother a ags:WADD }
}""" ;
.

agssh:WADD-key-null
    a sh:SPARQLConstraint ;
    sh:message "Another WADD record has the same combination of KEY fields (LOCA_ID, WADD_TOP, WADD_BASE): {?xother} (Rule 10a)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?xother WHERE {
    { FILTER (NOT EXISTS { $this ags:LOCA_ID ?n0 } || NOT EXISTS { $this ags:WADD_TOP ?n1 } || NOT EXISTS { $this ags:WADD_BASE ?n2 }) }
    ?xother a ags:WADD .
    FILTER (?xother != $this)
    OPTIONAL { $this ags:LOCA_ID ?a0 } OPTIONAL { ?xother ags:LOCA_ID ?b0 }
    OPTIONAL { $this ags:WADD_TOP ?a1 } OPTIONAL { ?xother ags:WADD_TOP ?b1 }
    OPTIONAL { $this ags:WADD_BASE ?a2 } OPTIONAL { ?xother ags:WADD_BASE ?b2 }
    FILTER (COALESCE(STR(?a0), "") = COALESCE(STR(?b0), "") && COALESCE(STR(?a1), "") = COALESCE(STR(?b1), "") && COALESCE(STR(?a2), "") = COALESCE(STR(?b2), ""))
}""" ;
.

agssh:WADD-parent
    a sh:PropertyShape ;
    sh:class ags:LOCA ;
    sh:description "The LOCA (Location Details) record this WADD record belongs to (Rule 10c)."@en ;
    sh:maxCount 1 ;
    sh:name "parent" ;
    sh:path agso:parent ;
    agso:rule <https://w3id.org/ags4/voc/rules/rule-10c> ;
.

agssh:WADD-parent-keys
    a sh:SPARQLConstraint ;
    sh:message "Key field {?path} = {?value} has no matching LOCA parent record (Rule 10c)" ;
    sh:prefixes <https://w3id.org/ags4/shapes> ;
    sh:select """SELECT $this ?path ?value WHERE {
    $this ?path ?value .
    FILTER (?path IN (ags:LOCA_ID))
    FILTER (STR(?value) != "")
    FILTER NOT EXISTS {
        $this agso:parent ?parent .
        ?parent ?path ?parentValue .
        FILTER (STR(?parentValue) = STR(?value))
    }
}""" ;
.

