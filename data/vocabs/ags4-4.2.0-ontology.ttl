agso:abbreviationList
    a owl:AnnotationProperty ;
    rdfs:label "abbreviation list"@en ;
    rdfs:comment "The collection of standard abbreviations for a heading of type PA."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:agsVersion
    a owl:DatatypeProperty ;
    rdfs:label "AGS version"@en ;
    rdfs:comment "The AGS edition a data file declares in TRAN_AGS."@en ;
    rdfs:domain agso:DataFile ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
    rdfs:range xsd:string ;
.

agso:dataFile
    a owl:ObjectProperty ;
    rdfs:label "data file"@en ;
    rdfs:comment "The AGS data file a record was read from."@en ;
    rdfs:domain agso:Record ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
    rdfs:range agso:DataFile ;
.

agso:dataType
    a owl:AnnotationProperty ;
    rdfs:label "data type"@en ;
    rdfs:comment "The suggested AGS data TYPE of a heading (a concept in the data types vocabulary)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:dictionaryEntry
    a owl:AnnotationProperty ;
    rdfs:label "dictionary entry"@en ;
    rdfs:comment "Links an OWL class, OWL property or SHACL shape to the concept describing it in the AGS dictionary vocabulary."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
    rdfs:subPropertyOf rdfs:seeAlso ;
.

agso:field
    a owl:ObjectProperty ;
    rdfs:label "field"@en ;
    rdfs:comment "A field definition of a data file."@en ;
    rdfs:domain agso:DataFile ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
    rdfs:range agso:FieldDefinition ;
.

agso:group
    a owl:AnnotationProperty ;
    rdfs:label "group"@en ;
    rdfs:comment "The group class a field definition belongs to."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:groupClass
    a owl:AnnotationProperty ;
    rdfs:label "group class"@en ;
    rdfs:comment "Links a group concept in the dictionary vocabulary to the OWL class of its records."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:heading
    a owl:AnnotationProperty ;
    rdfs:label "heading"@en ;
    rdfs:comment "The heading concept an abbreviation (or abbreviation list) belongs to."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:headingStatus
    a owl:AnnotationProperty ;
    rdfs:label "heading status"@en ;
    rdfs:comment "The raw AGS heading status: '*' (KEY), 'R' (REQUIRED), '*R' (both) or '' (OTHER)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:isKey
    a owl:AnnotationProperty ;
    rdfs:label "is key"@en ;
    rdfs:comment "True if the heading is a KEY field in the group (Rule 10a)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:isRequired
    a owl:AnnotationProperty ;
    rdfs:label "is required"@en ;
    rdfs:comment "True if the heading is a REQUIRED field in the group (Rule 10b)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:parent
    a owl:ObjectProperty ;
    rdfs:label "parent record"@en ;
    rdfs:comment "Links a record to the record in its PARENT GROUP whose KEY fields it shares (AGS Rule 10c)."@en ;
    rdfs:domain agso:Record ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
    rdfs:range agso:Record ;
.

agso:parentGroup
    a owl:AnnotationProperty ;
    rdfs:label "parent group"@en ;
    rdfs:comment "The PARENT GROUP of a group (between group classes or group concepts)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:position
    a owl:AnnotationProperty ;
    rdfs:label "position"@en ;
    rdfs:comment "Position of a heading in a group's HEADING row."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:property
    a owl:AnnotationProperty ;
    rdfs:label "heading property"@en ;
    rdfs:comment "The OWL property used for a heading's values (from a heading concept or a field definition)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:rule
    a owl:AnnotationProperty ;
    rdfs:label "rule"@en ;
    rdfs:comment "An AGS rule (concept in the rules vocabulary) a shape implements."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:suggestedUnit
    a owl:AnnotationProperty ;
    rdfs:label "suggested unit"@en ;
    rdfs:comment "The suggested AGS UNIT of a heading (a concept in the units vocabulary, or a literal when the unit is not in the standard UNIT list)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:type
    a owl:AnnotationProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "The TYPE declared in a data file (a data types concept, or a literal)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:unit
    a owl:AnnotationProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The UNIT declared in a data file (a units concept, or a literal for non-standard units)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

agso:userDefined
    a owl:AnnotationProperty ;
    rdfs:label "user defined"@en ;
    rdfs:comment "True for a group or heading not in the AGS dictionary (defined in the file's DICT group, Rule 18)."@en ;
    rdfs:isDefinedBy <https://w3id.org/ags4/ont> ;
.

